-- ============================================================
-- Window behavior (dragging, minimize, close, toggle)
-- ============================================================

-- Dragging (per-InputObject: a second pointer can neither steal nor end
-- the drag; clamped so the title bar always stays on screen)
local dragging = false
local dragSession = 0
local dragInput, dragStart, startPos

local function clampedPosition(x, y)
	local viewport = screenGui.AbsoluteSize
	-- constant width, not AbsoluteSize: the latter shrinks with the UIScale
	-- pop animations and would let the window settle offscreen
	local halfW = WINDOW_WIDTH / 2
	x = math.clamp(x, halfW, math.max(halfW, viewport.X - halfW))
	y = math.clamp(y, 0, math.max(0, viewport.Y - BAR_HEIGHT))
	return UDim2.fromOffset(x, y)
end

local function applyDrag(input)
	local delta = input.Position - dragStart
	local viewport = screenGui.AbsoluteSize
	local x = startPos.X.Scale * viewport.X + startPos.X.Offset + delta.X
	local y = startPos.Y.Scale * viewport.Y + startPos.Y.Offset + delta.Y
	window.Position = clampedPosition(x, y)
end

dragHandle.InputBegan:Connect(function(input)
	if dragging then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragSession += 1
		local session = dragSession
		dragStart = input.Position
		startPos = window.Position
		if input.UserInputType == Enum.UserInputType.Touch then
			-- a touch keeps one InputObject for its whole gesture, so bind
			-- the drag to the initiating finger right here
			dragInput = input
		else
			-- mouse drag: bound to the first MouseMovement after the press
			-- (in the service-level handler below)
			dragInput = nil
		end
		input.Changed:Connect(function()
			-- session check: an input held through a forced drag end (close,
			-- RightShift hide) must not kill a later, unrelated drag
			if input.UserInputState == Enum.UserInputState.End and session == dragSession then
				dragging = false
			end
		end)
	end
end)

table.insert(uisConnections, UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end
	if dragInput == nil and input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
	if input == dragInput then
		applyDrag(input)
	end
end))

-- Pixel positions set by dragging don't track resolution changes; re-clamp
-- when the viewport shrinks so the title bar stays reachable
screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	local viewport = screenGui.AbsoluteSize
	local pos = window.Position
	local x = pos.X.Scale * viewport.X + pos.X.Offset
	local y = pos.Y.Scale * viewport.Y + pos.Y.Offset
	local clamped = clampedPosition(x, y)
	if clamped ~= UDim2.fromOffset(x, y) then
		window.Position = clamped
	end
end)

-- ============================================================
-- Animated backdrop: blurred, pink-tinted screen with a drifting
-- star constellation. Fades in when the menu opens, out when hidden.
-- Wrapped in a do-block so only setBackdrop escapes (register budget).
-- ============================================================
local setBackdrop
do
	local Lighting = game:GetService("Lighting")
	-- clear any blur left over from a previous execution
	local oldBlur = Lighting:FindFirstChild("TB_MenuBlur")
	if oldBlur then
		oldBlur:Destroy()
	end
	local blur = Instance.new("BlurEffect")
	blur.Name = "TB_MenuBlur"
	blur.Size = 0
	blur.Parent = Lighting

	-- this ScreenGui keeps the top GUI inset, so extend the backdrop up (and
	-- out) past it to cover the whole screen, including the topbar strip
	local GuiService = game:GetService("GuiService")
	local insetTL, insetBR = GuiService:GetGuiInset()
	local coverPos = UDim2.new(0, -insetTL.X - 4, 0, -insetTL.Y - 4)
	local coverSize = UDim2.new(1, insetTL.X + insetBR.X + 8, 1, insetTL.Y + insetBR.Y + 8)

	-- dark pink wash that dims + tints the blurred world behind the menu
	local backdrop = Instance.new("Frame")
	backdrop.Position = coverPos
	backdrop.Size = coverSize
	backdrop.BackgroundColor3 = Color3.fromRGB(34, 12, 30)
	backdrop.BackgroundTransparency = 1
	backdrop.BorderSizePixel = 0
	backdrop.ZIndex = -5 -- behind the window: both are direct children of screenGui, so ZIndex orders them
	backdrop.Visible = false
	backdrop.Parent = screenGui
	local bgGrad = Instance.new("UIGradient")
	bgGrad.Rotation = 90
	bgGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 16, 48)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(17, 9, 22)),
	})
	bgGrad.Parent = backdrop
	onTheme(function()
		bgGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, themeAccent:Lerp(Color3.new(0, 0, 0), 0.72)),
			ColorSequenceKeypoint.new(1, themeAccent:Lerp(Color3.new(0, 0, 0), 0.9)),
		})
	end)

	-- canvas holding the drifting star dots + constellation links
	local starCanvas = Instance.new("Frame")
	starCanvas.Position = coverPos
	starCanvas.Size = coverSize
	starCanvas.BackgroundTransparency = 1
	starCanvas.BorderSizePixel = 0
	starCanvas.ZIndex = -5
	starCanvas.Visible = false
	starCanvas.Parent = screenGui

	local STAR_COUNT = 26
	local LINK_DIST = 175 -- px: stars closer than this get a link drawn
	local STAR_COLOR = Color3.fromRGB(255, 205, 226)
	local LINE_COLOR = Color3.fromRGB(237, 27, 118)
	local stars = {}
	for _ = 1, STAR_COUNT do
		local sz = 2 + math.random() * 2.5
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Size = UDim2.fromOffset(sz, sz)
		dot.BackgroundColor3 = STAR_COLOR
		dot.BackgroundTransparency = 0.1
		dot.BorderSizePixel = 0
		dot.ZIndex = -3
		dot.Parent = starCanvas
		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(1, 0)
		rc.Parent = dot
		stars[#stars + 1] = {
			frame = dot,
			x = math.random(),
			y = math.random(),
			vx = (math.random() - 0.5) * 0.05, -- normalized units / second
			vy = (math.random() - 0.5) * 0.05,
		}
	end

	-- recolor the constellation with the theme (lines = accent, stars = bright)
	onTheme(function()
		LINE_COLOR = themeAccent
		STAR_COLOR = themeBright
		for _, s in ipairs(stars) do
			s.frame.BackgroundColor3 = STAR_COLOR
		end
	end)

	-- pool of link frames, reused every frame (never more than we made)
	local lines = {}
	for i = 1, 200 do
		local ln = makeLine(starCanvas)
		ln.ZIndex = -4
		lines[i] = ln
	end

	local shown = false
	table.insert(uisConnections, RunService.RenderStepped:Connect(function(dt)
		if not shown then
			return
		end
		dt = math.clamp(dt, 0, 1 / 30)
		local size = starCanvas.AbsoluteSize
		for _, s in ipairs(stars) do
			s.x = s.x + s.vx * dt
			s.y = s.y + s.vy * dt
			if s.x <= 0 then
				s.x = 0
				s.vx = -s.vx
			elseif s.x >= 1 then
				s.x = 1
				s.vx = -s.vx
			end
			if s.y <= 0 then
				s.y = 0
				s.vy = -s.vy
			elseif s.y >= 1 then
				s.y = 1
				s.vy = -s.vy
			end
			s.frame.Position = UDim2.new(s.x, 0, s.y, 0)
		end
		-- link nearby stars; fade each link with distance
		local li = 0
		for i = 1, #stars do
			local ax, ay = stars[i].x * size.X, stars[i].y * size.Y
			for j = i + 1, #stars do
				if li >= #lines then
					break
				end
				local bx, by = stars[j].x * size.X, stars[j].y * size.Y
				local ddx, ddy = ax - bx, ay - by
				local d = math.sqrt(ddx * ddx + ddy * ddy)
				if d < LINK_DIST then
					li = li + 1
					drawLine(lines[li], ax, ay, bx, by, 1, LINE_COLOR, 0.35 + 0.6 * (d / LINK_DIST))
				end
			end
		end
		for k = li + 1, #lines do
			lines[k].Visible = false
		end
	end))

	function setBackdrop(visible)
		if visible then
			shown = true
			backdrop.Visible = true
			starCanvas.Visible = true
			TweenService:Create(backdrop, TweenInfo.new(0.35), { BackgroundTransparency = 0.35 }):Play()
			TweenService:Create(blur, TweenInfo.new(0.35), { Size = 18 }):Play()
		else
			TweenService:Create(backdrop, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
			local bt = TweenService:Create(blur, TweenInfo.new(0.25), { Size = 0 })
			-- only tear down on a NATURAL finish; a fast reopen cancels this
			-- tween (firing Completed with Cancelled) and must NOT hide the stars
			bt.Completed:Once(function(state)
				if state == Enum.PlaybackState.Completed then
					shown = false
					backdrop.Visible = false
					starCanvas.Visible = false
				end
			end)
			bt:Play()
		end
	end

	-- make sure the blur can't outlive the menu
	screenGui.Destroying:Connect(function()
		pcall(function()
			blur:Destroy()
		end)
	end)
end

