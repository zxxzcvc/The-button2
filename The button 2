local buildTeleportPage
do
	-- Save a position / TP back to it
	local savedPos = nil
	local function savePosition()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			savedPos = hrp.CFrame
			local p = hrp.Position
			notify("Position Saved", string.format("at %d, %d, %d", math.floor(p.X), math.floor(p.Y), math.floor(p.Z)))
		end
	end
	local function tpToSaved()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp and savedPos then
			hrp.CFrame = savedPos
			hrp.AssemblyLinearVelocity = Vector3.zero
			notify("Teleported", "back to your saved position")
		end
	end

	-- TP to the map's button (part/model named "button", preferring a prompt)
	local function tpToButton()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		local target, pos
		for _, d in ipairs(Workspace:GetDescendants()) do
			if (d:IsA("BasePart") or d:IsA("Model")) and d.Name:lower():find("button", 1, true) then
				target = d
				if d:FindFirstChildWhichIsA("ProximityPrompt", true) then
					break
				end
			end
		end
		if target then
			pos = target:IsA("BasePart") and target.Position or target:GetPivot().Position
		end
		if pos then
			hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
		else
			warn("[The Button] couldn't find the button")
		end
	end

	-- TP up to the sky with a safe platform under your feet so you don't fall
	local skyPlatform = nil
	local function tpToSky()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		local x, z = hrp.Position.X, hrp.Position.Z
		local skyY = 1500
		if skyPlatform then
			skyPlatform:Destroy()
		end
		skyPlatform = Instance.new("Part")
		skyPlatform.Name = "TB_SkyPlatform"
		skyPlatform.Size = Vector3.new(28, 1, 28)
		skyPlatform.Anchored = true
		skyPlatform.CanCollide = true
		skyPlatform.Transparency = 0.4
		skyPlatform.Material = Enum.Material.Neon
		skyPlatform.Color = Color3.fromRGB(120, 130, 170)
		skyPlatform.Position = Vector3.new(x, skyY - 3.5, z)
		skyPlatform.Parent = Workspace
		hrp.CFrame = CFrame.new(x, skyY, z)
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	screenGui.Destroying:Connect(function()
		if skyPlatform then
			skyPlatform:Destroy()
		end
	end)

