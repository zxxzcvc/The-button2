-- global key handling: capture a bind while picking, else toggle a bound feature
table.insert(uisConnections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local key = input.KeyCode
	if bindListen then
		local target = bindListen
		bindListen = nil
		if key == Enum.KeyCode.Escape then
			target.onSet(nil)
		else
			target.onSet(key)
			Keybinds[key] = { configKey = target.configKey, label = target.label }
		end
		refreshBindHud()
		return
	end
	if gameProcessed then
		return
	end
	local bind = Keybinds[key]
	if bind then
		local c = Config.byKey[bind.configKey]
		if c then
			local ok, cur = pcall(c.get)
			if ok then
				pcall(c.set, not cur)
			end
		end
	end
end))
end -- close the keybind-HUD do-block

-- ============================================================
-- Top-center "NEXT EVENT" box (on by default). The Button runs round events
-- (e.g. Breach); we mirror the game's event value here. Source detection is
-- best-effort by name — if it shows "—", tell me the exact object and I'll pin it.
-- ============================================================
do
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local eventHud = Instance.new("Frame")
	eventHud.Name = "EventHud"
	eventHud.AnchorPoint = Vector2.new(0.5, 0)
	eventHud.Position = UDim2.new(0.5, 0, 0, 10)
	eventHud.Size = UDim2.fromOffset(250, 48)
	eventHud.BackgroundColor3 = Color3.fromRGB(18, 14, 22)
	eventHud.BackgroundTransparency = 0.15
	eventHud.BorderSizePixel = 0
	eventHud.ZIndex = 30
	eventHud.Parent = screenGui
	local ehCorner = Instance.new("UICorner")
	ehCorner.CornerRadius = UDim.new(0, 8)
	ehCorner.Parent = eventHud
	local ehStroke = Instance.new("UIStroke")
	ehStroke.Color = ACCENT
	onTheme(function()
		ehStroke.Color = themeAccent
	end)
	ehStroke.Transparency = 0.4
	ehStroke.Parent = eventHud
	local ehGrad = Instance.new("UIGradient")
	ehGrad.Rotation = 90
	ehGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 16, 28)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(16, 12, 20)),
	})
	ehGrad.Parent = eventHud
	local ehTitle = Instance.new("TextLabel")
	ehTitle.Position = UDim2.new(0, 0, 0, 6)
	ehTitle.Size = UDim2.new(1, 0, 0, 14)
	ehTitle.BackgroundTransparency = 1
	ehTitle.Text = "NEXT EVENT"
	ehTitle.TextColor3 = ACCENT_BRIGHT
	onTheme(function()
		ehTitle.TextColor3 = themeBright
	end)
	ehTitle.TextSize = 11
	ehTitle.Font = Enum.Font.GothamBold
	ehTitle.ZIndex = 31
	ehTitle.Parent = eventHud
	local ehValue = Instance.new("TextLabel")
	ehValue.Position = UDim2.new(0, 8, 0, 20)
	ehValue.Size = UDim2.new(1, -16, 0, 22)
	ehValue.BackgroundTransparency = 1
	ehValue.Text = "—"
	ehValue.TextColor3 = Color3.fromRGB(255, 255, 255)
	ehValue.TextSize = 18
	ehValue.Font = Enum.Font.GothamBold
	ehValue.TextTruncate = Enum.TextTruncate.AtEnd
	ehValue.ZIndex = 31
	ehValue.Parent = eventHud

	local eventSource = nil

	-- ================================================================
	-- Robust "next event" detection (adversarially designed & verified).
	-- Two channels feed one priority list:
	--   A (whitelist): the text is EXACTLY a known event word.
	--   B (structural): the container NAME carries a tight event token
	--     (currentevent / roundevent / ...) AND the text is shape-clean —
	--     this admits NEW event names that aren't in our list yet.
	-- A central exclusion gate rejects connected player names, username-
	-- shaped text, round STATES (waiting/intermission/...), and chat/shop/
	-- tip subtrees. A "rolling" detector locks onto whatever cycles through
	-- >=2 known events during the ~10s roll — uniquely the real event box.
	-- ================================================================

	-- CHANNEL A vocabulary — whole-text exact match. Extend only with real events.
	local KNOWN_EVENTS = {
		["breach"] = 1, ["gamble"] = 1, ["flood"] = 1, ["storm"] = 1, ["fog"] = 1,
		["gas"] = 1, ["fire"] = 1, ["bomb"] = 1, ["nuke"] = 1, ["laser"] = 1,
		["missile"] = 1, ["acid"] = 1, ["wind"] = 1, ["overtime"] = 1, ["lava"] = 1,
		["ice"] = 1, ["freeze"] = 1, ["blackout"] = 1, ["darkness"] = 1, ["poison"] = 1,
		["meteor"] = 1, ["tornado"] = 1, ["radiation"] = 1, ["spikes"] = 1, ["crusher"] = 1,
		["sabotage"] = 1, ["purge"] = 1, ["frenzy"] = 1, ["rush"] = 1, ["drought"] = 1,
		["earthquake"] = 1, ["blizzard"] = 1, ["sudden death"] = 1, ["lights out"] = 1,
	}

	-- CHANNEL B tight name tokens. Over-generic words (status/round/stage/wave/
	-- phase/game...) stay REMOVED — they matched state-UI + player-list boxes.
	local EVENT_WORDS = { "nextevent", "currentevent", "roundevent", "eventname", "eventtype", "eventlabel" }
	-- names that contain an event token only by accident
	local NAME_ANTIWORDS = { "ground", "around", "surround" }

	-- Round STATE / outcome / difficulty / mode / economy / connection blacklist.
	-- None is a KNOWN_EVENTS key or an event's first word, so no real event is lost.
	local STATE = {
		intermission = 1, waiting = 1, loading = 1, starting = 1, start = 1, started = 1,
		ending = 1, ended = 1, lobby = 1, ready = 1, standby = 1, warmup = 1, paused = 1,
		spectating = 1, spectator = 1, respawning = 1, matchmaking = 1, queue = 1, queued = 1,
		go = 1, begin = 1, prepare = 1, preparing = 1, get = 1, ["not"] = 1, restart = 1,
		restarting = 1, countdown = 1, playing = 1, active = 1, idle = 1, afk = 1, away = 1,
		["you"] = 1, died = 1, dead = 1, killed = 1, wasted = 1, survived = 1, survivor = 1,
		victory = 1, defeat = 1, eliminated = 1, winner = 1, loser = 1, draw = 1, results = 1,
		alive = 1, out = 1, safe = 1, knocked = 1, downed = 1, revived = 1, respawned = 1,
		["you died"] = 1, ["you win"] = 1, ["you lose"] = 1, ["game over"] = 1,
		["not ready"] = 1, ["get ready"] = 1, ["in progress"] = 1,
		easy = 1, normal = 1, medium = 1, hard = 1, extreme = 1, nightmare = 1, insane = 1,
		impossible = 1, hardcore = 1, hell = 1,
		classic = 1, casual = 1, ranked = 1, unranked = 1, custom = 1, default = 1, solo = 1,
		duo = 1, squad = 1, ffa = 1, sandbox = 1, creative = 1, practice = 1, tutorial = 1,
		coins = 1, coin = 1, cash = 1, gems = 1, gem = 1, gold = 1, tokens = 1, token = 1,
		bucks = 1, credits = 1, credit = 1, money = 1, wallet = 1, balance = 1, points = 1,
		score = 1, xp = 1, rank = 1,
		online = 1, offline = 1, connecting = 1, connected = 1, reconnecting = 1,
		disconnected = 1, timeout = 1, unstable = 1, lagging = 1,
	}

	-- subtree names that mean chat / shop / reward / tips / stats — never the event box
	local SUBTREE_BAD = {
		"chat", "textchat", "bubblechat", "message", "whisper",
		"shop", "store", "inventory", "backpack", "hotbar", "loadout", "gear",
		"reward", "drop", "prize", "crate", "unbox", "item",
		"badge", "achiev", "award", "unlock", "trophy", "medal",
		"tip", "hint", "tutorial", "guide", "help", "loadingscreen",
		"leaderstat", "playerdata", "stats",
	}

	local function norm(s)
		if type(s) ~= "string" then
			return ""
		end
		s = s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
		return s:lower()
	end

	-- shape gate (CHANNEL B primary text guard): short, letters, no digit/underscore/url/prompt
	local function isEventText(s)
		if type(s) ~= "string" then
			return false
		end
		local t = s:gsub("^%s+", ""):gsub("%s+$", "")
		local n = #t
		if n < 3 or n > 22 then
			return false
		end
		if not t:find("%a") then
			return false
		end
		if t:find("%d") or t:find("_") or t:find("://", 1, true) then
			return false
		end
		local low = t:lower()
		local bad = { "?", "use ", "press", "hold ", "equip", "click", "tap ", " to ", "[", "]", "mask" }
		for _, b in ipairs(bad) do
			if low:find(b, 1, true) then
				return false
			end
		end
		return true
	end

	-- backstop for names not in the current list / internal ids (non-event values only)
	local function isLikelyUsername(raw)
		if type(raw) ~= "string" then
			return true
		end
		return raw:find("%d") ~= nil or raw:find("_") ~= nil
	end

	-- reject text equal to a connected player's Name/DisplayName (non-event values only)
	local function isPlayerName(low)
		for _, p in ipairs(Players:GetPlayers()) do
			if low == p.Name:lower() or low == p.DisplayName:lower() then
				return true
			end
		end
		return false
	end

	-- reject round STATES / outcomes / modes / economy (whole text AND first word)
	local function isState(low)
		if STATE[low] then
			return true
		end
		local w1 = low:match("^%a+")
		return w1 ~= nil and STATE[w1] == 1
	end

	-- CHANNEL B name test: tight tokens only, never inside Ground/Around/Surround
	local function isEventName(objName)
		local low = objName:lower()
		for _, anti in ipairs(NAME_ANTIWORDS) do
			if low:find(anti, 1, true) then
				return false
			end
		end
		for _, w in ipairs(EVENT_WORDS) do
			if low:find(w, 1, true) then
				return true
			end
		end
		return false
	end

	local function inExcludedSubtree(inst)
		local a = inst.Parent
		while a and a ~= game do
			local an = a.Name:lower()
			for _, bad in ipairs(SUBTREE_BAD) do
				if an:find(bad, 1, true) then
					return true
				end
			end
			a = a.Parent
		end
		return false
	end

	-- central exclusion gate (both channels). Player-name/username checks are
	-- SKIPPED for a whitelisted value (there they could only suppress a genuine
	-- event, e.g. a player named "Breach" while Breach is live); STATE + subtree
	-- always apply.
	local function passesExclusions(rawText, inst)
		local low = norm(rawText)
		if low == "" then
			return false
		end
		if not KNOWN_EVENTS[low] then
			if isPlayerName(low) or isLikelyUsername(rawText) then
				return false
			end
		end
		if isState(low) then
			return false
		end
		if inst and inExcludedSubtree(inst) then
			return false
		end
		return true
	end

	-- rolling corroboration: the one element that cycles through >=2 distinct
	-- known events during the ~10s roll is uniquely the real event box
	local rollSeen = setmetatable({}, { __mode = "k" })
	local function recordRoll(inst, low)
		if not KNOWN_EVENTS[low] then
			return
		end
		local rec = rollSeen[inst]
		if not rec then
			rec = { count = 0, last = nil, set = {} }
			rollSeen[inst] = rec
		end
		if rec.last ~= low then
			rec.last = low
			if not rec.set[low] then
				rec.set[low] = true
				rec.count = rec.count + 1
			end
		end
	end
	local function hasRolled(inst)
		local rec = rollSeen[inst]
		return rec ~= nil and rec.count >= 2
	end

	local function readOf(inst)
		if inst:IsA("StringValue") then
			return inst.Value
		end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") then
			return inst.Text
		end
		return nil
	end

	-- CHANNEL A: value is an exact known event and clears exclusions
	local function eligibleWhitelist(inst)
		local raw = readOf(inst)
		if not raw then
			return false
		end
		local low = norm(raw)
		if not KNOWN_EVENTS[low] then
			return false
		end
		if not passesExclusions(raw, inst) then
			return false
		end
		recordRoll(inst, low)
		return true
	end

	-- CHANNEL B: event-named container + shape-clean value (value need not be known)
	local function eligibleNamed(inst)
		local raw = readOf(inst)
		if not raw then
			return false
		end
		if not isEventName(inst.Name) then
			return false
		end
		if not isEventText(raw) then
			return false
		end
		if not passesExclusions(raw, inst) then
			return false
		end
		local low = norm(raw)
		if KNOWN_EVENTS[low] then
			recordRoll(inst, low)
		end
		return true
	end

	local function stillValid(inst)
		return eligibleWhitelist(inst) or eligibleNamed(inst)
	end

	local function findEventSource()
		local ok, res = pcall(function()
			local pg = player:FindFirstChildOfClass("PlayerGui")
			local rsWL, wsWL, guiWL = {}, {}, {}
			local rsNamed, wsNamed, guiNamed = {}, {}, {}

			for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
				if d:IsA("StringValue") then
					if eligibleWhitelist(d) then rsWL[#rsWL + 1] = d end
					if eligibleNamed(d) then rsNamed[#rsNamed + 1] = d end
				end
			end
			for _, d in ipairs(Workspace:GetDescendants()) do
				if d:IsA("StringValue") then
					if eligibleWhitelist(d) then wsWL[#wsWL + 1] = d end
					if eligibleNamed(d) then wsNamed[#wsNamed + 1] = d end
				end
			end
			if pg then
				for _, d in ipairs(pg:GetDescendants()) do
					if d:IsA("TextLabel") or d:IsA("TextButton") then
						if eligibleWhitelist(d) then guiWL[#guiWL + 1] = d end
						if eligibleNamed(d) then guiNamed[#guiNamed + 1] = d end
					end
				end
			end

			-- P1: definitive rolling display (cycled >=2 distinct known events)
			for _, list in ipairs({ rsWL, wsWL, guiWL }) do
				for _, d in ipairs(list) do
					if hasRolled(d) then
						return d
					end
				end
			end
			-- P2-4: structural named event source (admits unknown event words; beats name coincidence)
			if rsNamed[1] then return rsNamed[1] end
			if wsNamed[1] then return wsNamed[1] end
			if guiNamed[1] then return guiNamed[1] end
			-- P5-7: whitelist value in an event-named container
			for _, d in ipairs(rsWL) do if isEventName(d.Name) then return d end end
			for _, d in ipairs(wsWL) do if isEventName(d.Name) then return d end end
			for _, d in ipairs(guiWL) do if isEventName(d.Name) then return d end end
			-- P8-9: any whitelist value (generic container, last resort)
			if guiWL[1] then return guiWL[1] end
			if rsWL[1] then return rsWL[1] end
			if wsWL[1] then return wsWL[1] end
			return nil
		end)
		return ok and res or nil
	end

	local function pretty(s)
		s = tostring(s):gsub("^%s+", ""):gsub("%s+$", "")
		if s == "" then
			return ""
		end
		return s:sub(1, 1):upper() .. s:sub(2)
	end

	-- poll: hold a valid source; only re-scan after 2s of continuous invalidity
	-- (so a mid-roll blank doesn't cause a re-scan), and never flicker to "—"
	-- while the locked source is still present
	local lastShown = nil
	local findAccum, valAccum = 999, 0
	table.insert(uisConnections, RunService.Heartbeat:Connect(function(dt)
		findAccum = findAccum + dt
		valAccum = valAccum + dt
		local valid = eventSource ~= nil and eventSource.Parent ~= nil and stillValid(eventSource)
		if valid then
			findAccum = 0
		elseif findAccum >= 2 then
			findAccum = 0
			eventSource = findEventSource()
			valid = eventSource ~= nil
		end
		if valAccum >= 0.3 then
			valAccum = 0
			if valid then
				local p = pretty(readOf(eventSource) or "")
				if p ~= "" then
					lastShown = p
					ehValue.Text = p
				end
			elseif lastShown and eventSource and eventSource.Parent then
				ehValue.Text = lastShown -- hold the last real event through a mid-roll blank
			else
				lastShown = nil
				ehValue.Text = "—"
			end
		end
	end))
end

-- ============================================================
-- Toast notifications: slide in from the bottom-right, stack, auto-dismiss.
-- notify(message) is used for save/teleport/item-spawn popups.
-- ============================================================
local notify
do
	local TOAST_W, TOAST_H = 240, 50
	local toasts = {} -- index 1 = newest (bottom); older ones stack upward

	local function layout()
		for i, t in ipairs(toasts) do
			local yOff = -12 - (i - 1) * (TOAST_H + 8)
			TweenService:Create(t, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(1, -12, 1, yOff),
			}):Play()
		end
	end

	function notify(title, sub)
		local t = Instance.new("Frame")
		t.AnchorPoint = Vector2.new(1, 1)
		t.Size = UDim2.fromOffset(TOAST_W, TOAST_H)
		t.Position = UDim2.new(1, TOAST_W + 60, 1, -12) -- start off-screen to the right
		t.BackgroundColor3 = Color3.fromRGB(24, 20, 30)
		t.BackgroundTransparency = 0.08
		t.BorderSizePixel = 0
		t.ZIndex = 60
		t.Parent = screenGui
		local tc = Instance.new("UICorner")
		tc.CornerRadius = UDim.new(0, 8)
		tc.Parent = t
		local ts = Instance.new("UIStroke")
		ts.Color = themeAccent
		ts.Transparency = 0.4
		ts.Parent = t
		local bar = Instance.new("Frame")
		bar.Position = UDim2.new(0, 6, 0.5, 0)
		bar.AnchorPoint = Vector2.new(0, 0.5)
		bar.Size = UDim2.new(0, 4, 1, -14)
		bar.BackgroundColor3 = themeAccent
		bar.BorderSizePixel = 0
		bar.ZIndex = 61
		bar.Parent = t
		local barc = Instance.new("UICorner")
		barc.CornerRadius = UDim.new(1, 0)
		barc.Parent = bar
		local lbl = Instance.new("TextLabel")
		lbl.Position = UDim2.new(0, 18, 0, sub and 6 or 0)
		lbl.Size = UDim2.new(1, -28, 0, sub and 20 or TOAST_H)
		lbl.BackgroundTransparency = 1
		lbl.Text = title
		lbl.TextColor3 = Color3.fromRGB(238, 238, 248)
		lbl.TextSize = 13
		lbl.Font = Enum.Font.GothamBold
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.TextYAlignment = sub and Enum.TextYAlignment.Bottom or Enum.TextYAlignment.Center
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.ZIndex = 61
		lbl.Parent = t
		if sub then
			local sublbl = Instance.new("TextLabel")
			sublbl.Position = UDim2.new(0, 18, 0, 27)
			sublbl.Size = UDim2.new(1, -28, 0, 16)
			sublbl.BackgroundTransparency = 1
			sublbl.Text = sub
			sublbl.TextColor3 = MUTED_TEXT
			sublbl.TextSize = 11
			sublbl.Font = Enum.Font.Gotham
			sublbl.TextXAlignment = Enum.TextXAlignment.Left
			sublbl.TextYAlignment = Enum.TextYAlignment.Top
			sublbl.TextTruncate = Enum.TextTruncate.AtEnd
			sublbl.ZIndex = 61
			sublbl.Parent = t
		end

		table.insert(toasts, 1, t)
		-- cap the stack so item spam can't fill the screen
		while #toasts > 5 do
			local old = table.remove(toasts)
			if old then
				old:Destroy()
			end
		end
		layout()

		task.delay(2.6, function()
			local idx = table.find(toasts, t)
			if idx then
				table.remove(toasts, idx)
			end
			local out = TweenService:Create(t, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.new(1, TOAST_W + 60, t.Position.Y.Scale, t.Position.Y.Offset),
			})
			out.Completed:Once(function()
				t:Destroy()
			end)
			out:Play()
			layout()
		end)
	end
end

local function makeSlider(parent, y, labelText, minValue, maxValue, default, callback)
	local row = Instance.new("Frame")
	row.Position = UDim2.new(0, 0, 0, y)
	row.Size = UDim2.new(1, 0, 0, 48)
	row.BackgroundTransparency = 1
	row.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -70, 0, 16)
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = CONTROL_TEXT
	label.TextSize = 14
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row

	local valueLabel = Instance.new("TextLabel")
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.new(1, 0, 0, 0)
	valueLabel.Size = UDim2.new(0, 64, 0, 16)
	valueLabel.BackgroundTransparency = 1
	valueLabel.TextColor3 = ACCENT_BRIGHT
	valueLabel.TextSize = 13
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = row

	local track = Instance.new("Frame")
	track.Position = UDim2.new(0, 0, 0, 36)
	track.Size = UDim2.new(1, 0, 0, 6)
	track.BackgroundColor3 = CONTROL_BG
	track.BorderSizePixel = 0
	track.Parent = row

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = ACCENT
	fill.BorderSizePixel = 0
	fill.Parent = track
	onTheme(function()
		fill.BackgroundColor3 = themeAccent
		valueLabel.TextColor3 = themeBright
	end)

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(0, 0, 0.5, 0)
	knob.Size = UDim2.fromOffset(14, 14)
	knob.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
	knob.BorderSizePixel = 0
	knob.ZIndex = 2
	knob.Parent = track

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = knob

	-- nil until the user first drags, so setting the knob to the far-left
	-- minimum still fires the callback (the min can equal the default)
	local value = nil

	local function setValue(v)
		v = math.floor(math.clamp(v, minValue, maxValue) + 0.5)
		local frac = (v - minValue) / (maxValue - minValue)
		fill.Size = UDim2.new(frac, 0, 1, 0)
		knob.Position = UDim2.new(frac, 0, 0.5, 0)
		valueLabel.Text = tostring(v)
		if v ~= value then
			value = v
			callback(v)
		end
	end

	local function updateFromX(xPixel)
		local frac = math.clamp((xPixel - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		setValue(minValue + frac * (maxValue - minValue))
	end

	-- oversized invisible hitbox so the thin track is easy to grab
	local hitbox = Instance.new("TextButton")
	hitbox.Position = UDim2.new(0, 0, 0, 26)
	hitbox.Size = UDim2.new(1, 0, 0, 22)
	hitbox.BackgroundTransparency = 1
	hitbox.Text = ""
	hitbox.Parent = row

	hitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeDrag = function(pos)
				updateFromX(pos.X)
			end
			updateFromX(input.Position.X)
		end
	end)

	-- initialize visuals without firing the callback
	local frac = (default - minValue) / (maxValue - minValue)
	fill.Size = UDim2.new(frac, 0, 1, 0)
	knob.Position = UDim2.new(frac, 0, 0.5, 0)
	valueLabel.Text = tostring(default)

	-- config get/set (falls back to the default until the user first drags)
	Config.register(labelText, function()
		return value or default
	end, function(v)
		if typeof(v) == "number" then
			setValue(v)
		end
	end)

	return row
end

local function makeToggle(parent, y, labelText, default, callback, rightInset, bindable)
	rightInset = rightInset or 0
	local row = Instance.new("TextButton")
	row.Position = UDim2.new(0, 0, 0, y)
	row.Size = UDim2.new(1, 0, 0, 36)
