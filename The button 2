-- ============================================================

local espEnabled = false
local offscreenArrows = false -- Visual tab: draw arrows toward off-screen enemies

-- ============================================================
-- Rainbow / RGB ESP: one shared animated hue that any ESP element can use in
-- place of its fixed colour. `spread` gives each target its own stable hue
-- offset so the whole scene reads as a moving rainbow gradient. Base colours
-- are never touched (configs still save them) — this only overrides at draw
-- time via espCol(), so turning Rainbow off restores each element instantly.
-- ============================================================
-- only rainbowState / strSeed / espCol escape; the rest is do-block-scoped so it
-- doesn't hold top-level local registers (Luau's 200-per-function cap)
local rainbowState, strSeed, espCol
do
	rainbowState = { enabled = false, speed = 3, spread = false }
	local rainbowHue = 0
	table.insert(uisConnections, RunService.Heartbeat:Connect(function(dt)
		if rainbowState.enabled then
			rainbowHue = (rainbowHue + dt * 0.06 * rainbowState.speed) % 1
		end
	end))
	-- stable [0,100003) hash of a string/number, for a per-target hue offset
	function strSeed(s)
		local t = tostring(s)
		local n = 0
		for i = 1, #t do
			n = (n * 31 + t:byte(i)) % 100003
		end
		return n
	end
	local function rainbowColor(seed)
		local h = rainbowHue
		if rainbowState.spread and seed then
			h = (h + (seed % 1000) / 1000) % 1
		end
		return Color3.fromHSV(h, 1, 1)
	end
	-- the animated colour when Rainbow is on, otherwise the element's own colour
	function espCol(cfg, seed)
		if rainbowState.enabled then
			return rainbowColor(seed)
		end
		return cfg.color
	end
end

