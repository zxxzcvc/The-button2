local function iconFill(parent, x, y, w, h, round, rotation)
	local f = Instance.new("Frame")
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BackgroundColor3 = MUTED_ICON
	f.BorderSizePixel = 0
	f.Rotation = rotation or 0
	if round then
		local c = Instance.new("UICorner")
		c.CornerRadius = round
		c.Parent = f
	end
	f.Parent = parent
	return f
end

local function iconOutline(parent, x, y, w, h, round)
	local f = Instance.new("Frame")
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	if round then
		local c = Instance.new("UICorner")
		c.CornerRadius = round
		c.Parent = f
	end
	local stroke = Instance.new("UIStroke")
	stroke.Color = MUTED_ICON
	stroke.Thickness = 1.5
	stroke.Parent = f
	f.Parent = parent
	return f
end

