-- ============================================================
-- Settings: save/load config + live info (users online, time, version)
-- Wrapped in a do-block; only buildSettingsPage escapes.
-- ============================================================
local BUILD = 136
local buildSettingsPage
do
	local hasFiles = typeof(writefile) == "function" and typeof(readfile) == "function"
	local CONFIG_DIR = "TheButtonMenu"
	local hasFolder = typeof(makefolder) == "function"
	local hasList = typeof(listfiles) == "function"
	if hasFolder then
		pcall(makefolder, CONFIG_DIR)
	end
	local function configPath(name)
		return CONFIG_DIR .. "/" .. name .. ".json"
	end
	local timeLabel, onlineLabel -- assigned when the page builds
	local toggleKeyBtn -- the "change menu key" button, assigned when the page builds
	local listeningForKey = false

	local function keyLabel(k)
		return (typeof(k) == "EnumItem") and k.Name or "None"
	end

	-- capture the next key press when the user is rebinding the menu toggle
	table.insert(uisConnections, UserInputService.InputBegan:Connect(function(input)
		if not listeningForKey then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			listeningForKey = false
			local newKey = input.KeyCode
			if newKey ~= Enum.KeyCode.Escape then
				-- defer so THIS keypress doesn't also hit the toggle handler
				-- (which would immediately open/close the menu on rebind)
				task.defer(function()
					TOGGLE_KEY = newKey
				end)
				if toggleKeyBtn then
					toggleKeyBtn.Text = newKey.Name
				end
			elseif toggleKeyBtn then
				toggleKeyBtn.Text = keyLabel(TOGGLE_KEY)
			end
		end
	end))

	-- persist the menu key with the rest of the config
	Config.register("Menu Toggle Key", function()
		return keyLabel(TOGGLE_KEY)
	end, function(v)
		if type(v) ~= "string" then
			return
		end
		local ok, kc = pcall(function()
			return Enum.KeyCode[v]
		end)
		if ok and kc then
			TOGGLE_KEY = kc
			if toggleKeyBtn then
				toggleKeyBtn.Text = keyLabel(TOGGLE_KEY)
			end
		end
	end)

	-- ===== config (de)serialization — shared by file save/load AND share codes ==
	-- Colors (accent + every ESP color) can't be JSON-encoded as Color3, so they're
	-- captured as {r,g,b} triples.
	local function c3rgb(col)
		return { math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5) }
	end
	local function serializeToTable()
		local data = {}
		for _, c in ipairs(Config.controls) do
			local ok, v = pcall(c.get)
			if ok then
				data[c.key] = v
			end
		end
		local colors = {
			accent = c3rgb(themeAccent),
			itemEsp = c3rgb(itemEspConfig.color),
			npcZombie = c3rgb(npcEspConfig.Zombie.color),
			npcGuard = c3rgb(npcEspConfig.Guard.color),
			espBox = c3rgb(espConfig.Box.color),
			espShader = c3rgb(espConfig.Shader.color),
			espOutline = c3rgb(espConfig.Outline.color),
			espTracer = c3rgb(espConfig.Tracer.color),
			espSkeleton = c3rgb(espConfig.Skeleton.color),
			weaponChams = c3rgb(weaponChamsConfig.color),
		}
		return { version = BUILD, controls = data, colors = colors }
	end
	local function serializeConfig()
		local ok, json = pcall(function()
			return HttpService:JSONEncode(serializeToTable())
		end)
		return ok and json or nil
	end
	local function applyDecoded(decoded)
		if typeof(decoded) ~= "table" then
			return false, "corrupt"
		end
		local controls = decoded.controls or decoded
		if typeof(controls) ~= "table" then
			return false, "corrupt"
		end
		local n = 0
		for key, val in pairs(controls) do
			local c = Config.byKey[key]
			if c then
				pcall(c.set, val)
				n = n + 1
			end
		end
		local colors = decoded.colors
		if typeof(colors) == "table" then
			local function toC3(t)
				if typeof(t) == "table" and typeof(t[1]) == "number" then
					return Color3.fromRGB(t[1], t[2], t[3])
				end
				return nil
			end
			local cc
			cc = toC3(colors.itemEsp)
			if cc then itemEspConfig.color = cc end
			cc = toC3(colors.npcZombie)
			if cc then npcEspConfig.Zombie.color = cc end
			cc = toC3(colors.npcGuard)
			if cc then npcEspConfig.Guard.color = cc end
			cc = toC3(colors.espBox)
			if cc then espConfig.Box.color = cc end
			cc = toC3(colors.espShader)
			if cc then espConfig.Shader.color = cc end
			cc = toC3(colors.espOutline)
			if cc then espConfig.Outline.color = cc end
			cc = toC3(colors.espTracer)
			if cc then espConfig.Tracer.color = cc end
			cc = toC3(colors.espSkeleton)
			if cc then espConfig.Skeleton.color = cc end
			cc = toC3(colors.weaponChams)
			if cc then
				weaponChamsConfig.color = cc
				pcall(updateWeaponChams)
			end
			pcall(updateItemEspColor)
			pcall(updateNpcEspColor)
			cc = toC3(colors.accent)
			if cc then pcall(setAccent, cc) end
		end
		return true, n
	end
	local function applyConfigJson(json)
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(json)
		end)
		if not ok then
			return false, "corrupt"
		end
		return applyDecoded(decoded)
	end

	-- ===== share codes: base64 of the config JSON, copy/pasteable as a string ====
	local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local function b64encode(data)
		local out, i = {}, 1
		while i <= #data do
			local b1 = string.byte(data, i)
			local b2 = string.byte(data, i + 1)
			local b3 = string.byte(data, i + 2)
			local nn = b1 * 65536 + (b2 or 0) * 256 + (b3 or 0)
			out[#out + 1] = B64:sub(math.floor(nn / 262144) % 64 + 1, math.floor(nn / 262144) % 64 + 1)
			out[#out + 1] = B64:sub(math.floor(nn / 4096) % 64 + 1, math.floor(nn / 4096) % 64 + 1)
			out[#out + 1] = b2 and B64:sub(math.floor(nn / 64) % 64 + 1, math.floor(nn / 64) % 64 + 1) or "="
			out[#out + 1] = b3 and B64:sub(nn % 64 + 1, nn % 64 + 1) or "="
			i = i + 3
		end
		return table.concat(out)
	end
	local B64LUT
	local function b64decode(s)
		if not B64LUT then
			B64LUT = {}
			for k = 1, 64 do
				B64LUT[B64:sub(k, k)] = k - 1
			end
		end
		local out, acc, bits = {}, 0, 0
		for i = 1, #s do
			local v = B64LUT[s:sub(i, i)]
			if v then
				acc = acc * 64 + v
				bits = bits + 6
				if bits >= 8 then
					bits = bits - 8
					out[#out + 1] = string.char(math.floor(acc / (2 ^ bits)) % 256)
					acc = acc % (2 ^ bits)
				end
			end
		end
		return table.concat(out)
	end
	-- Compact codec: encode the config POSITIONALLY (in Config.controls order) so the
	-- code carries no JSON key names or punctuation — ~10x shorter than the old base64
	-- JSON. Per value: tag 0/1 = false/true, 2 = uint16, 3 = number-as-string, 4 =
	-- string; then 10 colours as raw RGB bytes. Same build encodes and decodes.
	local COLOR_ORDER = { "accent", "itemEsp", "npcZombie", "npcGuard", "espBox", "espShader", "espOutline", "espTracer", "espSkeleton", "weaponChams" }
	local function encodeCompact(decoded)
		local controls = decoded.controls or {}
		local colors = decoded.colors or {}
		local out = {}
		local function u8(n)
			out[#out + 1] = string.char(math.floor(n) % 256)
		end
		u8((decoded.version or BUILD) % 256)
		u8(#Config.controls % 256)
		for _, c in ipairs(Config.controls) do
			local v = controls[c.key]
			local t = type(v)
			if t == "boolean" then
				u8(v and 1 or 0)
			elseif t == "number" and v == math.floor(v) and v >= 0 and v <= 65535 then
				u8(2)
				u8(math.floor(v / 256))
				u8(v % 256)
			elseif t == "number" then
				local s = tostring(v)
				u8(3)
				u8(#s % 256)
				out[#out + 1] = s
			elseif t == "string" then
				local s = string.sub(v, 1, 255)
				u8(4)
				u8(#s)
				out[#out + 1] = s
			else
				u8(5) -- absent/unknown; keeps positions aligned
			end
		end
		for _, name in ipairs(COLOR_ORDER) do
			local rgb = colors[name]
			if type(rgb) == "table" and type(rgb[1]) == "number" then
				u8(rgb[1])
				u8(rgb[2])
				u8(rgb[3])
			else
				u8(255)
				u8(255)
				u8(255)
			end
		end
		return table.concat(out)
	end
	local function decodeCompact(data)
		local pos = 1
		local function rb()
			local b = string.byte(data, pos) or 0
			pos = pos + 1
			return b
		end
		local version = rb()
		local n = rb()
		local controls = {}
		for i = 1, n do
			local tag = rb()
			local val
			if tag == 0 then
				val = false
			elseif tag == 1 then
				val = true
			elseif tag == 2 then
				local hi = rb()
				val = hi * 256 + rb()
			elseif tag == 3 then
				local len = rb()
				val = tonumber(string.sub(data, pos, pos + len - 1))
				pos = pos + len
			elseif tag == 4 then
				local len = rb()
				val = string.sub(data, pos, pos + len - 1)
				pos = pos + len
			end
			local c = Config.controls[i]
			if c and val ~= nil then
				controls[c.key] = val
			end
		end
		local colors = {}
		for _, name in ipairs(COLOR_ORDER) do
			colors[name] = { rb(), rb(), rb() }
		end
		return { version = version, controls = controls, colors = colors }
	end
	-- build a share code from a decoded table (defaults to the live config)
	local function makeShareCode(decoded)
		decoded = decoded or serializeToTable()
		if type(decoded) ~= "table" then
			return nil
		end
		local ok, bin = pcall(encodeCompact, decoded)
		if not ok or not bin then
			return nil
		end
		return "TBC2|" .. b64encode(bin)
	end
	local function importConfigString(str)
		if type(str) ~= "string" or str == "" then
			return false, "paste a code"
		end
		str = str:gsub("%s", "")
		-- new short format
		local c2 = str:match("TBC2|(.+)$")
		if c2 then
			local ok, bin = pcall(b64decode, c2)
			if not ok or not bin or bin == "" then
				return false, "bad code"
			end
			local okd, decoded = pcall(decodeCompact, bin)
			if not okd or type(decoded) ~= "table" then
				return false, "bad code"
			end
			return applyDecoded(decoded)
		end
		-- legacy TBCFG1 (base64 of the full JSON) still loads
		local payload = str:match("TBCFG1|(.+)$") or str
		local ok, json = pcall(b64decode, payload)
		if not ok or not json or json == "" then
			return false, "bad code"
		end
		return applyConfigJson(json)
	end

	local function saveConfig(name)
		if not hasFiles then
			return false, "writefile unsupported"
		end
		if not name or name == "" then
			return false, "enter a name"
		end
		local json = serializeConfig()
		if not json then
			return false, "encode failed"
		end
		if hasFolder then
			pcall(makefolder, CONFIG_DIR)
		end
		local ok2 = pcall(writefile, configPath(name), json)
		return ok2, ok2 and ("saved '" .. name .. "'") or "write failed"
	end

	local function loadConfig(name)
		if not hasFiles then
			return false, "readfile unsupported"
		end
		local path = configPath(name)
		if typeof(isfile) == "function" and not isfile(path) then
			return false, "not found"
		end
		local ok, json = pcall(readfile, path)
		if not ok or not json then
			return false, "not found"
		end
		local okA, res = applyConfigJson(json)
		if not okA then
			return false, res
		end
		return true, ("loaded '" .. name .. "' (" .. tostring(res) .. ")")
	end

	-- read a saved config off disk as a decoded table (for the per-row Copy button)
	local function readConfigDecoded(name)
		if not hasFiles then
			return nil
		end
		local path = configPath(name)
		if typeof(isfile) == "function" and not isfile(path) then
			return nil
		end
		local ok, json = pcall(readfile, path)
		if not ok or not json then
			return nil
		end
		local okd, decoded = pcall(function()
			return HttpService:JSONDecode(json)
		end)
		return okd and decoded or nil
	end

	local function deleteConfig(name)
		if typeof(delfile) == "function" then
			pcall(delfile, configPath(name))
		end
	end

	-- names of every saved config (strip the folder path + .json)
	local function listConfigs()
		local names = {}
		if not hasList then
			return names
		end
		local ok, files = pcall(listfiles, CONFIG_DIR)
		if ok and type(files) == "table" then
			for _, f in ipairs(files) do
				local nm = tostring(f):match("([^/\\]+)%.json$")
				if nm then
					names[#names + 1] = nm
				end
			end
		end
		return names
	end

	-- 1s tick: update the clock and the live server player count. (A true global
	-- "users running this script" count needs a backend we don't have; the real
	-- server population is the honest live number — it's 1 when you're alone.)
	local clockAcc = 0
	table.insert(uisConnections, RunService.Heartbeat:Connect(function(dt)
		clockAcc = clockAcc + dt
		if clockAcc >= 1 then
			clockAcc = 0
			if timeLabel then
				timeLabel.Text = os.date("%H:%M:%S")
			end
			if onlineLabel then
				onlineLabel.Text = tostring(#Players:GetPlayers())
			end
		end
	end))

