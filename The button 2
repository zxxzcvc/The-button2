			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if char and hum and hum.Health > 0 then
				expandPart(char:FindFirstChild("HumanoidRootPart"), size)
				expandPart(char:FindFirstChild("Head"), size)
			end
		end
	end
end))

