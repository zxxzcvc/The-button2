-- The model is always oriented to face -Z (the rig is built that way; the
-- cloned avatar is pivoted to match), so the camera sits on the -Z FRONT side,
-- a touch to the right and above — a 3/4 view that faces the viewer.
local function frameModel(model)
	local cf, size = model:GetBoundingBox()
	local center = cf.Position
	local fitSize = math.max(size.X, size.Y)
	local dist = (fitSize / 2) / math.tan(math.rad(vpCamera.FieldOfView / 2)) * 1.15 + 1.5
	local camPos = center + Vector3.new(dist * 0.26, size.Y * 0.08, -dist * 0.965)
	vpCamera.CFrame = CFrame.lookAt(camPos, center + Vector3.new(0, size.Y * 0.02, 0))
end

