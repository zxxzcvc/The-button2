-- Tracers/skeletons are thin GUI-frame lines in the IgnoreGuiInset ScreenGui
-- (the executor Drawing API is unreliable on MacSploit, so this avoids it).
local TRACER_THICKNESS = 1

local espObjects = {} -- [player] = { box, boxStroke, tracer, highlight, healthBg, healthFill, bones }

local function makeEspObject()
	local box = Instance.new("Frame")
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Visible = false
	box.Parent = espGui
	local boxStroke = Instance.new("UIStroke")
	boxStroke.Thickness = 1.5
	boxStroke.Parent = box

	local tracer = makeLine(espGui)

	local highlight = Instance.new("Highlight")
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = false
	highlight.Parent = espGui

	-- vertical health bar (background + bottom-anchored fill), left of the box
	local healthBg = Instance.new("Frame")
	healthBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	healthBg.BackgroundTransparency = 0.4
	healthBg.BorderSizePixel = 0
	healthBg.Visible = false
	healthBg.Parent = espGui
	local healthFill = Instance.new("Frame")
	healthFill.AnchorPoint = Vector2.new(0, 1)
	healthFill.Position = UDim2.new(0, 0, 1, 0)
	healthFill.BorderSizePixel = 0
	healthFill.Parent = healthBg

	local bones = {}
	for i = 1, SKELETON_MAX do
		bones[i] = makeLine(espGui)
	end

	return {
		box = box, boxStroke = boxStroke, tracer = tracer, highlight = highlight,
		healthBg = healthBg, healthFill = healthFill, bones = bones,
	}
end

local function hideObj2D(obj)
	obj.box.Visible = false
	obj.tracer.Visible = false
	obj.healthBg.Visible = false
	for _, bn in ipairs(obj.bones) do
		bn.Visible = false
	end
end

local function destroyEspObject(obj)
	obj.box:Destroy()
	obj.tracer:Destroy()
	obj.highlight:Destroy()
	obj.healthBg:Destroy()
	for _, bn in ipairs(obj.bones) do
		bn:Destroy()
	end
end

local function removeEspFor(plr)
	local obj = espObjects[plr]
	if obj then
		destroyEspObject(obj)
		espObjects[plr] = nil
	end
end

