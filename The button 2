	header.TextXAlignment = Enum.TextXAlignment.Left
	header.Parent = page

	local sub = Instance.new("TextLabel")
	sub.Position = UDim2.new(0, 0, 0, 27)
	sub.Size = UDim2.new(1, 0, 0, 16)
	sub.BackgroundTransparency = 1
	sub.Text = def.desc
	sub.TextColor3 = MUTED_TEXT
	sub.TextSize = 13
	sub.Font = Enum.Font.Gotham
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.Parent = page

	if def.build then
		-- isolate each page: if one page's builder hits an unsupported executor API,
		-- that page is left empty but every other tab still loads (was: one failure
		-- halted the whole tab loop → blank UI on some executors)
		local ok, err = pcall(def.build, page)
		if not ok then
			warn("[The Button] page '" .. def.name .. "' failed to build: " .. tostring(err))
		end
