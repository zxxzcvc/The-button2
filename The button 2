-- refresh the ON/OFF suffix + colour for every bind row (called on a heartbeat)
local function updateBindStates()
	for _, r in ipairs(bindRows) do
		local on = false
		local c = Config.byKey[r.configKey]
		if c then
			local ok, cur = pcall(c.get)
			on = (ok and cur) and true or false
		end
		r.label.Text = r.keyName .. "  —  " .. r.featLabel .. (on and "  [ON]" or "  [OFF]")
		r.label.TextColor3 = on and Color3.fromRGB(120, 240, 140) or Color3.fromRGB(185, 185, 200)
	end
end

function refreshBindHud()
	for _, ch in ipairs(bindHud:GetChildren()) do
		if ch:IsA("TextLabel") and ch ~= bhTitle then
			ch:Destroy()
		end
	end
	bindRows = {}
	local order, count = 1, 0
	for key, info in pairs(Keybinds) do
		count = count + 1
		local rowLbl = Instance.new("TextLabel")
		rowLbl.Size = UDim2.new(1, 0, 0, 16)
		rowLbl.BackgroundTransparency = 1
		rowLbl.TextColor3 = Color3.fromRGB(185, 185, 200)
		rowLbl.TextSize = 13
		rowLbl.Font = Enum.Font.GothamSemibold
		rowLbl.TextXAlignment = Enum.TextXAlignment.Left
		rowLbl.TextTruncate = Enum.TextTruncate.AtEnd
		rowLbl.LayoutOrder = order
		rowLbl.ZIndex = 31
		rowLbl.Parent = bindHud
		bindRows[#bindRows + 1] = { label = rowLbl, configKey = info.configKey, keyName = shortKeyName(key), featLabel = info.label }
		order = order + 1
	end
	bindHud.Visible = count > 0
	updateBindStates()
end

