local function updateEspFor(plr, camera)
	local obj = espObjects[plr]
	if not obj then
		obj = makeEspObject()
		espObjects[plr] = obj
	end

	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local alive = espEnabled and char and hum and hum.Health > 0 and root ~= nil

	if not alive then
		hideObj2D(obj)
		obj.highlight.Enabled = false
		return
	end

	-- shader + outline via Highlight
	local hueSeed = plr.UserId -- per-player offset for rainbow "spread"
	local s = espConfig.Shader
	local o = espConfig.Outline
	obj.highlight.Adornee = char
	obj.highlight.FillColor = espCol(s, hueSeed)
	obj.highlight.FillTransparency = s.enabled and (1 - s.alpha) or 1
	obj.highlight.OutlineColor = espCol(o, hueSeed)
	obj.highlight.OutlineTransparency = o.enabled and (1 - o.alpha) or 1
	obj.highlight.Enabled = s.enabled or o.enabled

	local b = espConfig.Box
	local t = espConfig.Tracer
	local he = espConfig.Health
	local sk = espConfig.Skeleton
	if not (b.enabled or t.enabled or he.enabled or sk.enabled) then
		hideObj2D(obj)
		return
	end

	-- Project top-center and bottom-center (world-vertical axis) so the box
	-- doesn't wobble as the player turns.
	local cf, size = char:GetBoundingBox()
	local center = cf.Position
	local centerS = camera:WorldToViewportPoint(center)
	if centerS.Z <= 0 then
		hideObj2D(obj)
		return
	end

	local halfY = size.Y / 2
	local topS = camera:WorldToViewportPoint(center + Vector3.new(0, halfY, 0))
	local botS = camera:WorldToViewportPoint(center - Vector3.new(0, halfY, 0))
	local heightPx = math.abs(topS.Y - botS.Y)
	local widthPx = heightPx * 0.45
	local topY = math.min(topS.Y, botS.Y)
	local botY = math.max(topS.Y, botS.Y)
	local cx = centerS.X
	local boxLeft = cx - widthPx / 2

	-- box
	if b.enabled and heightPx > 1 then
		obj.box.Position = UDim2.fromOffset(boxLeft, topY)
		obj.box.Size = UDim2.fromOffset(widthPx, heightPx)
		obj.boxStroke.Color = espCol(b, hueSeed)
		obj.boxStroke.Transparency = 1 - b.alpha
		obj.box.Visible = true
	else
		obj.box.Visible = false
	end

	-- tracer from the bottom-center of the screen to the feet
	if t.enabled then
		local vp = camera.ViewportSize
		drawLine(obj.tracer, vp.X / 2, vp.Y, cx, botY, TRACER_THICKNESS, espCol(t, hueSeed), 1 - t.alpha)
	else
		obj.tracer.Visible = false
	end

	-- vertical health bar on the LEFT of the box (green full → red empty)
	if he.enabled and heightPx > 1 then
		local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
		local barW = 3
		obj.healthBg.Position = UDim2.fromOffset(boxLeft - barW - 2, topY)
		obj.healthBg.Size = UDim2.fromOffset(barW, heightPx)
		obj.healthFill.Size = UDim2.new(1, 0, frac, 0)
		obj.healthFill.BackgroundColor3 = Color3.new(1 - frac, frac, 0)
		obj.healthBg.Visible = true
	else
		obj.healthBg.Visible = false
	end

	-- skeleton: project each bone's two endpoints and draw a line
	if sk.enabled then
		local list = char:FindFirstChild("UpperTorso") and SKELETON_R15 or SKELETON_R6
		local li = 0
		for _, pair in ipairs(list) do
			local p1 = char:FindFirstChild(pair[1])
			local p2 = char:FindFirstChild(pair[2])
			if p1 and p2 and li < SKELETON_MAX then
				local a = camera:WorldToViewportPoint(p1.Position)
				local c = camera:WorldToViewportPoint(p2.Position)
				if a.Z > 0 and c.Z > 0 then
					li += 1
					drawLine(obj.bones[li], a.X, a.Y, c.X, c.Y, TRACER_THICKNESS, espCol(sk, hueSeed), 1 - sk.alpha)
				end
			end
		end
		for i = li + 1, SKELETON_MAX do
			obj.bones[i].Visible = false
		end
	else
		for _, bn in ipairs(obj.bones) do
			bn.Visible = false
		end
	end
end

