end))

-- Infinite stamina: keep any stamina-named value / attribute maxed out.
-- Best-effort — it targets value objects or attributes named like "stamina".
-- If the game tracks stamina purely in a local variable, this can't reach it.
local STAMINA_HIGH = 1000000
table.insert(uisConnections, RunService.Heartbeat:Connect(function()
	if not playerState.infStamina then
		return
	end
	-- The Button stores stamina as Humanoid attributes
	local hum = getHumanoid()
	if hum then
		hum:SetAttribute("MaxStamina", math.huge)
		hum:SetAttribute("Stamina", math.huge)
	end
	-- generic fallback: any stamina-named value / attribute elsewhere
	local function boost(root)
		if not root then
			return
		end
		for _, v in ipairs(root:GetDescendants()) do
			if (v:IsA("NumberValue") or v:IsA("IntValue")) and string.find(string.lower(v.Name), "stam", 1, true) then
				v.Value = STAMINA_HIGH
			end
		end
		for name in pairs(root:GetAttributes()) do
			if string.find(string.lower(name), "stam", 1, true) then
				root:SetAttribute(name, STAMINA_HIGH)
			end
		end
	end
	boost(player.Character)
	boost(player:FindFirstChild("leaderstats"))
	boost(player:FindFirstChild("Stats"))
	boost(player:FindFirstChild("Data"))
	for name in pairs(player:GetAttributes()) do
		if string.find(string.lower(name), "stam", 1, true) then
			player:SetAttribute(name, STAMINA_HIGH)
		end
	end
end))

-- Fetch a URL through whatever HTTP entry point this executor exposes
local function httpGet(url)
	local ok, res = pcall(function()
		return game:HttpGet(url, true)
	end)
	if ok and type(res) == "string" and #res > 0 then
		return res
	end
	-- request-style fallbacks (MacSploit / others)
	local reqFn = (syn and syn.request) or request or http_request or (http and http.request)
	if reqFn then
		local ok2, res2 = pcall(reqFn, { Url = url, Method = "GET" })
		if ok2 and type(res2) == "table" and res2.Body then
			return res2.Body
		end
	end
	return nil
end

local IY_URL = "https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"
local iyLoading = false

local function loadInfiniteYield(btn)
	if iyLoading then
		return
	end
	iyLoading = true
	-- BaseText is the button's real label, immune to earlier "failed" states
	local baseText = btn:GetAttribute("BaseText") or btn.Text
	btn.Text = "Loading Infinite Yield..."

	task.spawn(function()
		local okDone, err = false, nil
		local src = httpGet(IY_URL)
		-- some executors (e.g. Potassium) don't expose loadstring at all
		local ls = (typeof(loadstring) == "function" and loadstring)
			or (typeof(load) == "function" and load) or nil
		if not ls then
			err = "this executor has no loadstring"
		elseif src then
			local fn, compileErr = ls(src, "InfiniteYield")
			if fn then
				okDone, err = pcall(fn)
			else
				err = compileErr
			end
		else
			err = "download failed"
		end

		iyLoading = false
		if btn.Parent then
			if okDone then
				btn.Text = "Infinite Yield loaded"
				task.delay(2, function()
					if btn.Parent then
						btn.Text = baseText
					end
				end)
			else
				btn.Text = "IY failed — click to retry"
				warn("[The Button] Infinite Yield failed: " .. tostring(err))
			end
		end
	end)
end

