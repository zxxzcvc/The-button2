-- Bring items: for each workspace item (ToolType attribute) with a DropPrompt,
-- teleport to it, fire the prompt to collect it, then return to the start.
exploitState.autoBring = false
local bringBusy = false
local autoBringGen = 0 -- only the newest auto loop keeps running
local autoBringHome = nil -- safe CFrame we snap back to if flung off the map
local autoBringPaused = false -- true during the 10s fall-recovery cooldown
canFirePrompt = typeof(fireproximityprompt) == "function"

-- shouldContinue() lets the auto-loop abort a run in progress (e.g. when it's
-- toggled off or the menu closes) so it can't keep teleporting you.
local function bringItems(shouldContinue)
	if bringBusy then
		return
	end
	shouldContinue = shouldContinue or function()
		return true
	end
	local function root()
		local c = player.Character
		return c and c:FindFirstChild("HumanoidRootPart")
	end
	local start = root()
	if not (start and canFirePrompt) then
		return
	end
	bringBusy = true
	local returnCF = start.CFrame
	local preVel = start.AssemblyLinearVelocity -- keep your walking momentum
	autoBringHome = returnCF -- current safe spot; fall-recovery snaps back here
	local moved = false
	local grabbed = 0
	local MAX_PER_CYCLE = 2 -- short grab-bursts so walking stays responsive
	for _, item in ipairs(Workspace:GetChildren()) do
		if grabbed >= MAX_PER_CYCLE or not shouldContinue() then
			break
		end
		if item:GetAttribute("ToolType") then
			for _, trigger in ipairs(item:GetDescendants()) do
				if not shouldContinue() then
					break
				end
				if trigger:IsA("ProximityPrompt") and trigger.Name == "DropPrompt" then
					local r = root()
					if r and trigger.Parent then
						r.CFrame = trigger.Parent.CFrame + Vector3.new(0, 3, 0)
						-- kill any velocity the teleport imparted so physics can't fling us
						r.AssemblyLinearVelocity = Vector3.zero
						r.AssemblyAngularVelocity = Vector3.zero
						moved = true
						task.wait(0.1) -- brief settle so the server sees the teleport
						pcall(function()
							fireproximityprompt(trigger, trigger.MaxActivationDistance)
						end)
						grabbed = grabbed + 1
						break -- one DropPrompt per item is enough
					end
				end
			end
		end
	end
	-- Only disturb the character if we actually teleported to grab something.
	-- When there's nothing to grab we leave you completely alone, and on return
	-- we RESTORE your momentum instead of dead-stopping you — that combination is
	-- what was making movement feel slow/buggy while Auto Bring was on.
	if moved then
		local r = root()
		if r then
			r.CFrame = returnCF
			r.AssemblyLinearVelocity = preVel
			r.AssemblyAngularVelocity = Vector3.zero
		end
	end
	bringBusy = false
end

-- Fall safety: rapid teleporting can occasionally fling us off the map. If we
-- drop far below where auto-bring started AND we're genuinely plummeting (not
-- just standing on lower ground / a short hop onto an item), snap back to the
-- safe spot and pause for 10s. Requiring BOTH "150+ studs below" and "falling
-- fast" is what keeps this from firing on normal terrain (no false positives).
table.insert(uisConnections, RunService.Heartbeat:Connect(function()
	if not exploitState.autoBring or autoBringPaused or not autoBringHome then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local farBelow = hrp.Position.Y < autoBringHome.Position.Y - 150
	local falling = hrp.AssemblyLinearVelocity.Y < -20
		or (hum and hum:GetState() == Enum.HumanoidStateType.Freefall)
	if farBelow and falling then
		autoBringPaused = true
		bringBusy = false -- release the lock so the in-progress run aborts
		hrp.CFrame = autoBringHome
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		notify("Auto Bring paused", "fell off the map — continuing in 10s")
		task.delay(10, function()
			local c = player.Character
			local h = c and c:FindFirstChild("HumanoidRootPart")
			if h then
				autoBringHome = h.CFrame -- re-home to wherever we safely are now
			end
			autoBringPaused = false
		end)
	end
end))

-- stop the auto loop when the menu closes so it can't keep teleporting you
screenGui.Destroying:Connect(function()
	exploitState.autoBring = false
