	boxText.TextSize = 13
	boxText.Font = Enum.Font.Gotham
	boxText.Parent = box

	return page
end

local pageInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function showPage(index, instant)
	for i, page in ipairs(pages) do
		page.Visible = (i == index)
	end
	local page = pages[index]
	page.Position = UDim2.new(0, 0, 0, 0)
	if instant then
		return
	end
	-- slide in from the right with a text/stroke fade
	page.Position = UDim2.new(0, 16, 0, 0)
	TweenService:Create(page, pageInfo, { Position = UDim2.new(0, 0, 0, 0) }):Play()
	for _, obj in ipairs(page:GetDescendants()) do
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			local target = obj:GetAttribute("FadeTarget") or 0
			obj.TextTransparency = 1
			TweenService:Create(obj, pageInfo, { TextTransparency = target }):Play()
		elseif obj:IsA("UIStroke") then
			local target = obj:GetAttribute("FadeTarget") or 0
			obj.Transparency = 1
			TweenService:Create(obj, pageInfo, { Transparency = target }):Play()
		end
	end
end

local tabInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function selectTab(index, instant)
	if currentTab == index then
		return
