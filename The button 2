-- true if nothing solid sits between the camera and the target part
local function visibleFromCamera(camera, part, char)
	local origin = camera.CFrame.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	-- build the ignore list without nil holes (player.Character can be nil)
	local ignore = { char }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	params.FilterDescendantsInstances = ignore
	local hit = Workspace:Raycast(origin, part.Position - origin, params)
	return hit == nil
end

-- snap the character to face a world position (yaw only) so a melee swing
-- connects even while spinbot is spinning the body around
local function faceTarget(targetPos)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		local p = hrp.Position
		-- skip if the target shares our XZ column, else CFrame.lookAt is NaN
		if (Vector2.new(targetPos.X, targetPos.Z) - Vector2.new(p.X, p.Z)).Magnitude > 0.05 then
			hrp.CFrame = CFrame.lookAt(p, Vector3.new(targetPos.X, p.Y, targetPos.Z))
		end
	end
end

