-- No hit cooldown: The Button gates re-hitting with the Humanoid attribute
-- "HitCooldown" (set true right after a hit). Forcing it back to false each
-- frame removes the ~2s wait so you can attack again immediately.
-- No fall damage: the character holds a "FallDamage" script — disable it (and
-- re-disable after respawn). Infinite inventory: keep the Humanoid attribute
-- "InventorySize" maxed each frame so it sticks (a one-shot set gets reset).
table.insert(uisConnections, RunService.Heartbeat:Connect(function()
	local char = player.Character
	if exploitState.noHitCooldown then
		local hum = getHumanoid()
		if hum and hum:GetAttribute("HitCooldown") then
			hum:SetAttribute("HitCooldown", false)
		end
	end
	if exploitState.noFallDamage and char then
		local fd = char:FindFirstChild("FallDamage")
		if fd then
			fd.Enabled = false
		end
	end
	if exploitState.infInventory then
		local hum = getHumanoid()
		-- Use a big FINITE capacity. math.huge broke the game's inventory math,
		-- which is why dropping bugged out and only some items worked. We also do
		-- NOT touch the current weight/count anymore (zeroing it broke dropping).
		local BIG = 999
		-- Method 1: set many likely capacity attribute names directly on the humanoid
		if hum then
			for _, a in ipairs({
				"InventorySize", "MaxInventory", "InventoryLimit", "MaxItems", "MaxSlots",
				"Slots", "MaxWeight", "MaxCarry", "Capacity", "MaxCapacity", "CarryLimit",
			}) do
				pcall(function()
					hum:SetAttribute(a, BIG)
				end)
			end
		end
		-- Method 2: sweep the character + backpack, raising capacity attrs/values
		local function sweep(root)
			if not root then
				return
			end
			local function isCapacity(n)
				return string.find(n, "max", 1, true) or string.find(n, "capacity", 1, true)
					or string.find(n, "limit", 1, true) or string.find(n, "invent", 1, true)
					or string.find(n, "slot", 1, true) or string.find(n, "storage", 1, true)
			end
			local list = { root }
			for _, d in ipairs(root:GetDescendants()) do
				list[#list + 1] = d
			end
			for _, node in ipairs(list) do
				local ok, attrs = pcall(function()
					return node:GetAttributes()
				end)
				if ok and attrs then
					for name, val in pairs(attrs) do
						if type(val) == "number" and isCapacity(string.lower(name)) then
							pcall(function()
								node:SetAttribute(name, BIG)
							end)
						end
					end
				end
				if (node:IsA("NumberValue") or node:IsA("IntValue")) and isCapacity(string.lower(node.Name)) then
					pcall(function()
						node.Value = BIG
					end)
				end
			end
		end
		sweep(hum)
		sweep(player.Character)
		sweep(player:FindFirstChildOfClass("Backpack"))
	end
end))





-- Reveal the map's landmines. Per the game (and the reference script), they are
-- parts named EXACTLY "Landmine" sitting directly under workspace.Minefield —
-- nothing else (not the sand, not the Minefield container). Reveal each
-- (Transparency = 0, like the reference) and add a red highlight on top.
local landmineHighlights = {} -- [part] = { hl, transparency }

local function removeMine(part)
	local data = landmineHighlights[part]
	if data then
		if data.hl then
			data.hl:Destroy()
		end
		if part and part.Parent and part:IsA("BasePart") and data.transparency ~= nil then
			part.Transparency = data.transparency
		end
		landmineHighlights[part] = nil
	end
end

local function highlightMine(part)
	if landmineHighlights[part] or not part:IsA("BasePart") then
		return
	end
	local data = { transparency = part.Transparency }
	part.Transparency = 0 -- reveal the actual mine, same as the reference
	local hl = Instance.new("Highlight")
	hl.Adornee = part
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillColor = Color3.fromRGB(255, 25, 25)
	hl.FillTransparency = 0.35
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.OutlineTransparency = 0
	hl.Parent = espGui
	data.hl = hl
	landmineHighlights[part] = data
end

local function clearMineHighlights()
	for part in pairs(landmineHighlights) do
		removeMine(part)
	end
end

local function scanMines()
	local mineField = Workspace:FindFirstChild("Minefield")
	if not mineField then
		return
	end
	for _, part in ipairs(mineField:GetChildren()) do
		if part.Name == "Landmine" and part:IsA("BasePart") then
			highlightMine(part)
		end
	end
end

local function setLandminesVisible(on)
	exploitState.landminesVisible = on
	if on then
		scanMines()
	else
		clearMineHighlights()
	end
end

-- keep the reveal current as rounds spawn/clear mines; drop highlights whose
