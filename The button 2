local function setIconColor(icon, color)
	for _, obj in ipairs(icon:GetDescendants()) do
		if obj:IsA("Frame") and obj.BackgroundTransparency < 1 then
			obj.BackgroundColor3 = color
		elseif obj:IsA("UIStroke") then
