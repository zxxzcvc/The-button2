-- ============================================================
-- Weapon Chams: make ONLY the item(s) you're holding glow. Applies to the
-- Tools currently in your character (equipped) — never other players' items.
-- Color / glow amount / glow type are all live-configurable.
-- ============================================================
local weaponChamsConfig = { enabled = false, color = Color3.fromRGB(0, 200, 255), amount = 0.6, glowType = "Chams", alpha = 1 }
local setWeaponChams, updateWeaponChams
do
	local applied = {} -- [part] = { kind = "material"|"inst", ... }
	local fpVm = {} -- [viewmodel BasePart] = Highlight, for the FIRST-PERSON weapon

	-- rig part names to skip, so we glow the weapon and not the viewmodel's arms/body
	local BODY_PARTS = {
		Head = true, Torso = true, HumanoidRootPart = true, UpperTorso = true,
		LowerTorso = true, RootPart = true,
		["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true,
		LeftHand = true, RightHand = true, LeftLowerArm = true, RightLowerArm = true,
		LeftUpperArm = true, RightUpperArm = true, LeftFoot = true, RightFoot = true,
		LeftLowerLeg = true, RightLowerLeg = true, LeftUpperLeg = true, RightUpperLeg = true,
	}

	-- In first person this game HIDES the held Tool (LocalTransparencyModifier=1) and
	-- shows a separate VIEWMODEL parented to the camera (Workspace.Camera.<ToolName>).
	-- A Highlight on the hidden Tool is invisible; the viewmodel is NOT the local
	-- first-person character, so a Highlight on IT renders normally — so in first
	-- person we glow the viewmodel's weapon parts instead of the Tool.
	-- undo everything applied to a viewmodel part: the Highlight, the Neon recolour,
	-- and any texture / SurfaceAppearance / mesh-texture we lifted to reveal the glow
	local function clearFpVm()
		for part, rec in pairs(fpVm) do
			if rec.hl then
				rec.hl:Destroy()
			end
			if rec.mesh and rec.meshTex ~= nil then
				pcall(function()
					rec.mesh.TextureId = rec.meshTex
					if rec.meshVc then rec.mesh.VertexColor = rec.meshVc end
				end)
			end
			for _, s in ipairs(rec.saved or {}) do
				pcall(function()
					s.inst.Parent = s.parent
				end)
			end
			if part and part.Parent then
				pcall(function()
					part.Material = rec.material
					part.Color = rec.color
					if rec.reflect then part.Reflectance = rec.reflect end
				end)
			end
		end
		fpVm = {}
	end

	-- First-person test = the camera sits right on the head. This game uses the
	-- default min-zoom, so a close camera IS first person (a MouseBehavior gate
	-- would falsely read third person whenever the menu frees the mouse). Read
	-- the camera fresh each call; hysteresis (1 in / 2 out) prevents edge flicker.
	local fpLatched = false
	local function inFirstPerson()
		local char = player.Character
		local head = char and char:FindFirstChild("Head")
		local cam = Workspace.CurrentCamera
		if not (head and cam) then
			fpLatched = false
			return false
		end
		if player.CameraMode == Enum.CameraMode.LockFirstPerson then
			fpLatched = true
			return true
		end
		local dist = (cam.CFrame.Position - head.Position).Magnitude
		if fpLatched then
			if dist > 2 then
				fpLatched = false
			end
		elseif dist < 1 then
			fpLatched = true
		end
		return fpLatched
	end

	local function clearGlow()
		clearFpVm()
		for part, o in pairs(applied) do
			if o.kind == "material" then
				if part and part.Parent then
					pcall(function()
						part.Material = o.material
						part.Color = o.color
					end)
				end
			elseif o.inst then
				o.inst:Destroy()
			end
		end
		applied = {}
	end

	-- Tools that are CHILDREN of my character = currently equipped/held (a Tool in
	-- the Backpack isn't a child of the character, and other players' tools live in
	-- their characters, which we never touch)
	local function heldTools()
		local char = player.Character
		local list = {}
		if char then
			for _, c in ipairs(char:GetChildren()) do
				if c:IsA("Tool") then
					list[#list + 1] = c
				end
			end
		end
		return list
	end

	local function applyGlow()
		clearGlow()
		if not weaponChamsConfig.enabled then
			return
		end
		local color = weaponChamsConfig.color
		local amount = math.clamp(weaponChamsConfig.amount, 0, 1)
		local gt = weaponChamsConfig.glowType
		for _, tool in ipairs(heldTools()) do
			for _, part in ipairs(tool:GetDescendants()) do
				if part:IsA("BasePart") then
					if gt == "Neon" or gt == "Force Field" then
						applied[part] = { kind = "material", material = part.Material, color = part.Color }
						part.Material = (gt == "Neon") and Enum.Material.Neon or Enum.Material.ForceField
						part.Color = color
					elseif gt == "Outline" then
						local sb = Instance.new("SelectionBox")
						sb.Adornee = part
						sb.Color3 = color
						sb.LineThickness = 0.02 + amount * 0.1
						sb.SurfaceTransparency = 1
						sb.Transparency = 0
						sb.Parent = part
						applied[part] = { kind = "inst", inst = sb }
					else -- Chams: a through-walls Highlight per part
						local hl = Instance.new("Highlight")
						hl.Adornee = part
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.FillColor = color
						hl.FillTransparency = 1 - amount
						hl.OutlineColor = color
						hl.OutlineTransparency = 0
						hl.Parent = part
						applied[part] = { kind = "inst", inst = hl }
					end
				end
			end
		end
	end

	function setWeaponChams(on)
		weaponChamsConfig.enabled = on
		applyGlow()
	end
	function updateWeaponChams()
		applyGlow()
	end

	-- Re-apply whenever the held-tool set (or a tool's part count) changes — this
	-- covers equipping/unequipping and parts streaming in a frame late. Cheap
	-- signature check on a 0.25s tick; no work at all while disabled.
	local lastSig, acc = "", 999
	table.insert(uisConnections, RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.25 then
			return
		end
		acc = 0
		if not weaponChamsConfig.enabled then
			if next(applied) then
				clearGlow()
				lastSig = ""
			end
			return
		end
		local sig = {}
		for _, tool in ipairs(heldTools()) do
			local n = 0
			for _, p in ipairs(tool:GetDescendants()) do
				if p:IsA("BasePart") then
					n = n + 1
				end
			end
			sig[#sig + 1] = tostring(tool) .. ":" .. n
		end
		local s = table.concat(sig, ",")
		if s ~= lastSig then
			lastSig = s
			applyGlow()
		end
	end))

	-- Per-frame first-person handling for the "Chams" type. In FP the game HIDES
	-- the real Tool (LocalTransparencyModifier raised) and shows a camera viewmodel
	-- (Workspace.Camera.<ToolName>). We detect FP straight from that signal (the
	-- Tool being hidden) — no camera-distance guessing — and glow the viewmodel's
	-- weapon parts with EVERY method at once so something is guaranteed to show:
	-- a Highlight, a Neon material recolour, and lifting any texture/SurfaceAppearance/
	-- mesh-texture that would otherwise hide the recolour. Restored on exit / swap /
	-- close. Stand down while spinbot spins.
	local function dropVmPart(part, rec)
		if rec.hl then rec.hl:Destroy() end
		if rec.mesh and rec.meshTex ~= nil then
			pcall(function()
				rec.mesh.TextureId = rec.meshTex
				if rec.meshVc then rec.mesh.VertexColor = rec.meshVc end
			end)
		end
		for _, s in ipairs(rec.saved or {}) do
			pcall(function() s.inst.Parent = s.parent end)
		end
		if part and part.Parent then
			pcall(function()
				part.Material = rec.material
				part.Color = rec.color
				if rec.reflect then part.Reflectance = rec.reflect end
			end)
		end
	end
	table.insert(uisConnections, RunService.RenderStepped:Connect(function()
		-- runs for ANY glow type: in first person the real Tool is hidden, so the
		-- per-type glow on it is invisible and the viewmodel must be glowed instead.
		-- (No spinbot guard needed: the glow is on the camera-locked VIEWMODEL, which
		-- doesn't spin with the character, so there's no doubled-glow to avoid.)
		if not weaponChamsConfig.enabled then
			if next(fpVm) then
				clearFpVm()
			end
			return
		end
		local color = weaponChamsConfig.color
		local amt = math.clamp(weaponChamsConfig.amount, 0, 1)
		local cam = Workspace.CurrentCamera
		local seen = {}
		if cam then
			for _, tool in ipairs(heldTools()) do
				-- FP = the game has hidden the real Tool (its parts' LTM is raised);
				-- only then is the camera viewmodel what you actually see
				local hidden = false
				for _, p in ipairs(tool:GetDescendants()) do
					if p:IsA("BasePart") and p.LocalTransparencyModifier > 0.5 then
						hidden = true
						break
					end
				end
				local vm = hidden and cam:FindFirstChild(tool.Name) or nil
				if hidden and not vm then
					for _, c in ipairs(cam:GetChildren()) do
						if c:IsA("Model") then
							vm = c
							break
						end
					end
				end
				if vm then
					for _, part in ipairs(vm:GetDescendants()) do
						if part:IsA("BasePart") and not BODY_PARTS[part.Name] and part.Transparency < 1 then
							seen[part] = true
							local rec = fpVm[part]
							if not rec then
								-- Highlight MUST be parented to Workspace (not under the Camera)
								-- with its Adornee set — a camera-parented Highlight is dropped
								-- and never renders (Roblox docs + devforum viewmodel fix)
								local hl = Instance.new("Highlight")
								hl.Adornee = part
								hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
								hl.OutlineTransparency = 0
								hl.Parent = Workspace
								-- lift anything that would override a Neon recolour
								local saved = {}
								for _, ch in ipairs(part:GetDescendants()) do
									if ch:IsA("SurfaceAppearance") or ch:IsA("Texture") or ch:IsA("Decal") then
										saved[#saved + 1] = { inst = ch, parent = ch.Parent }
										ch.Parent = nil
									end
								end
								rec = { hl = hl, material = part.Material, color = part.Color, reflect = part.Reflectance, saved = saved }
								-- a legacy SpecialMesh ignores Material and is textured;
								-- clear its texture + neutralise VertexColor so the part
								-- colour shows through as the glow colour
								local mesh = part:FindFirstChildOfClass("SpecialMesh")
								if mesh then
									rec.mesh = mesh
									rec.meshTex = mesh.TextureId
									rec.meshVc = mesh.VertexColor
								end
								fpVm[part] = rec
							end
							rec.hl.FillColor = color
							rec.hl.OutlineColor = color
							rec.hl.FillTransparency = 1 - amt
							-- RE-APPLY every frame: the game re-textures the viewmodel, so a
							-- one-time clear gets reverted the next frame
							pcall(function()
								if rec.mesh then
									rec.mesh.TextureId = ""
									rec.mesh.VertexColor = Vector3.new(1, 1, 1)
								end
								part.Material = Enum.Material.Neon -- glows if it's a MeshPart
								part.Color = color
								part.Reflectance = 0
							end)
						end
					end
				end
			end
		end
		-- undo parts no longer glowed (left FP / swapped weapon / viewmodel rebuilt)
		for part, rec in pairs(fpVm) do
			if not seen[part] or not part.Parent then
				dropVmPart(part, rec)
				fpVm[part] = nil
			end
		end
	end))

	-- clear the viewmodel highlights (and the Tool highlights) on menu close
	screenGui.Destroying:Connect(function()
		clearGlow()
	end)
end

