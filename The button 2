-- ============================================================
-- World: camera FOV, weapon chams, viewmodel offset, ambience, RTX shaders
-- Wrapped in a do-block; only buildWorldPage escapes.
-- ============================================================
local buildWorldPage
do
local Lighting = game:GetService("Lighting")
local worldState = {
	fovEnabled = false,
	fov = 90,
	vm = { x = 0, y = 0, z = 0 },
	ambience = false,
	ambienceCfg = { color = Color3.fromRGB(120, 160, 255), alpha = 1 },
	rtx = false,
	lowDetail = false,
}

-- Camera FOV: hold FieldOfView every frame. Also drive MaxAxisFieldOfView so the
-- value can pass the 120 engine cap on FieldOfView and reach ~180.
table.insert(uisConnections, RunService.RenderStepped:Connect(function()
	if not worldState.fovEnabled then
		return
	end
	local cam = Workspace.CurrentCamera
	if cam then
		pcall(function()
			cam.FieldOfView = math.min(worldState.fov, 120)
			cam.MaxAxisFieldOfView = math.clamp(worldState.fov, 1, 179)
		end)
	end
end))

-- Viewmodel offset: nudge the first-person weapon/arms (the Model(s) under the
-- Camera) by an X/Y/Z offset in VIEW space. The gun re-anchors its viewmodel every
-- RunService.RenderStepped, and RenderStepped fires AFTER BindToRenderStep — so a
-- Last-priority bind was overwritten every frame (that was the "no effect" bug). We
-- connect to RenderStepped and RE-CONNECT after each equip so ours is the LAST
-- RenderStepped handler registered (signals fire in connection order) and wins the
-- frame. +Z moves the model FORWARD; a distance guard stops any drift.
local function applyVmOffset()
	local vm = worldState.vm
	if vm.x == 0 and vm.y == 0 and vm.z == 0 then
		return
	end
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local offset = cam.CFrame:VectorToWorldSpace(Vector3.new(vm.x, vm.y, -vm.z))
	for _, m in ipairs(cam:GetChildren()) do
		if m:IsA("Model") then
			pcall(function()
				local piv = m:GetPivot()
				if (piv.Position - camPos).Magnitude < 15 then
					m:PivotTo(piv + offset)
				end
			end)
		end
	end
end

local vmConn
local function rebindVm()
	if vmConn then
		vmConn:Disconnect()
	end
	vmConn = RunService.RenderStepped:Connect(applyVmOffset)
end
rebindVm()

-- when a gun equips, its viewmodel is parented under the Camera; re-connect (deferred
-- to end of frame) so our handler registers AFTER the gun's and fires last
local function watchCameraForVm(cam)
	if cam then
		cam.ChildAdded:Connect(function(ch)
