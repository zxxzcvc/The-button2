-- ============================================================
-- NeverWin load-in splash: NEVERWIN "writes in" over a blurred backdrop, then it
-- smoothly clears and ONLY THEN does the menu animate in
-- ============================================================
do
	local Lighting = game:GetService("Lighting")
	local introGui = Instance.new("ScreenGui")
	introGui.Name = "NeverWinIntro"
	introGui.IgnoreGuiInset = true
	introGui.ResetOnSpawn = false
	introGui.DisplayOrder = 999999
	introGui.Parent = guiParent

	local introBlur = Instance.new("BlurEffect")
	introBlur.Name = "NeverWinIntroBlur"
	introBlur.Size = 0
	introBlur.Parent = Lighting

	local backdrop = Instance.new("Frame")
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(10, 7, 16)
	backdrop.BackgroundTransparency = 1
	backdrop.BorderSizePixel = 0
	backdrop.Parent = introGui
	local bgGrad = Instance.new("UIGradient")
	bgGrad.Rotation = 90
	bgGrad.Color = ColorSequence.new(Color3.fromRGB(42, 12, 42), Color3.fromRGB(8, 6, 14))
	bgGrad.Parent = backdrop

	-- giant NEVERWIN across the whole screen: one flat colour, no outline, slightly
	-- transparent
	local title = Instance.new("TextLabel")
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.new(0.5, 0, 0.5, 0)
	title.Size = UDim2.new(0.96, 0, 0.26, 0)
	title.BackgroundTransparency = 1
	title.Text = "NEVERWIN"
	title.TextScaled = true
	title.Font = Enum.Font.GothamBlack
	title.TextColor3 = themeAccent -- same pink as the menu accent
	title.TextTransparency = 0.25
	title.MaxVisibleGraphemes = 0 -- reveal the letters one at a time (write-in)
	title.Parent = introGui
	onTheme(function()
		title.TextColor3 = themeAccent
	end)

	-- timeline (non-blocking): blur in -> write NEVERWIN in letter by letter -> hold
	-- -> smoothly wipe it out -> destroy the splash -> THEN animate the menu in
	local qi = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	task.spawn(function()
		TweenService:Create(introBlur, qi, { Size = 24 }):Play()
		TweenService:Create(backdrop, qi, { BackgroundTransparency = 0.12 }):Play()
		task.wait(0.35)
		local n = #title.Text
		for i = 1, n do
			title.MaxVisibleGraphemes = i
			task.wait(0.09)
		end
		task.wait(1.1)
		local out = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(title, out, { TextTransparency = 1 }):Play()
		TweenService:Create(introBlur, out, { Size = 0 }):Play()
		TweenService:Create(backdrop, out, { BackgroundTransparency = 1 }):Play()
		task.wait(0.5)
		pcall(function()
			introBlur:Destroy()
		end)
		introGui:Destroy()
		-- reveal the menu now that the text has cleared
		setBackdrop(true)
		TweenService:Create(windowScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = userScale }):Play()
	end)
end

