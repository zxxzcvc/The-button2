-- Config registry: every toggle/slider registers a get/set here so the
-- Settings tab can save the whole menu state to a file and load it back.
-- Duplicate labels get a " #n" suffix so they stay distinct.
local Config = { controls = {}, byKey = {}, seen = {} }
function Config.register(label, getter, setter)
	local n = (Config.seen[label] or 0) + 1
	Config.seen[label] = n
	local key = n > 1 and (label .. " #" .. n) or label
	local c = { key = key, get = getter, set = setter }
	Config.controls[#Config.controls + 1] = c
	Config.byKey[key] = c
	return key
end

