-- Executor-safe GUI parent: gethui() > PlayerGui > CoreGui.
-- gethui() is protected + visible on executors that have it (MacSploit). When it's
-- absent (e.g. Potassium) we use PlayerGui, which ALWAYS renders — CoreGui is last
-- resort because some executors let you parent to it but never actually render it
-- (that's the "UI loaded but invisible" bug). ResetOnSpawn=false keeps the menu
-- through respawns even in PlayerGui, and the keep-alive re-parents it on teleports.
local function getGuiParent()
	local ok, hui = pcall(function()
		return (typeof(gethui) == "function") and gethui() or nil
	end)
	if ok and hui then
		return hui
	end
	local okpg, pg = pcall(function()
		return player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10)
	end)
	if okpg and pg then
		return pg
	end
	local okcg, cg = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okcg and cg then
		return cg
	end
	return player:WaitForChild("PlayerGui")
end

local guiParent = getGuiParent()

-- hide a GUI from the game's scripts so it survives round resets / teleports
local function protect(gui)
	pcall(function()
		if syn and syn.protect_gui then
			syn.protect_gui(gui)
		elseif typeof(protectgui) == "function" then
			protectgui(gui)
		end
	end)
end

-- Remove old copies wherever a previous run may have parented one
-- (destroying the old ScreenGui also fires its Destroying hook, which
-- disconnects that run's UserInputService connections)
local function destroyOld(container)
	if not container then
		return
	end
	-- the menu and its separate ESP ScreenGui, from any previous run
	for _, name in ipairs({ "TheButtonMenu", "TheButtonESP" }) do
		local old = container:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
end

