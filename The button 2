-- Keep the menu alive through teleports / round redirects. The game can orphan
-- the menu two ways: nil our Parent, OR detach an ANCESTOR (our Parent is still
-- set but we're no longer inside the DataModel). The old "parent == nil" guard
-- missed the second case, so a redirect that reset the CoreGui/gethui container
-- left the menu orphaned and invisible. Re-check with IsDescendantOf(game) and
-- re-resolve a live parent. A real close calls screenGui:Destroy(), which fires
-- Destroying -> disconnects the tracked watchdog below, so this never resurrects
-- a closed menu.
-- scoped so reattachIfOrphaned / reattachAcc don't hold top-level registers
do
local function reattachIfOrphaned()
	if destroyed then
		return
	end
	local menuLost = not screenGui:IsDescendantOf(game)
	local espLost = espGui ~= nil and not espGui:IsDescendantOf(game)
	if not (menuLost or espLost) then
		return
	end
	local target = getGuiParent()
	if not target then
		return
	end
	guiParent = target
	-- the ESP GUI is a SIBLING of the menu on the same container, so a redirect
	-- orphans both — reattach each. The "already at target" guard makes this a
	-- no-op once home, so it can never spin into an infinite re-parent fight.
	if menuLost and screenGui.Parent ~= target then
		pcall(function()
			protect(screenGui)
			screenGui.Parent = target
		end)
	end
	if espLost and espGui.Parent ~= target then
		pcall(function()
			protect(espGui)
			espGui.Parent = target
		end)
	end
end
screenGui.AncestryChanged:Connect(function()
	if not destroyed then
		task.defer(reattachIfOrphaned)
	end
end)
-- safety net: some redirects swap the container without a clean AncestryChanged,
-- so also poll a few times a second (cheap; the tracked connection is dropped on
-- a real close, so it can't fight the close button / Unload)
local reattachAcc = 0
table.insert(uisConnections, RunService.Heartbeat:Connect(function(dt)
	reattachAcc = reattachAcc + dt
	if reattachAcc >= 0.4 then
		reattachAcc = 0
		reattachIfOrphaned()
	end
end))
end

