-- Ambience: a screen-wide colour wash via a ColorCorrection tint
local ambCC = nil
local function applyAmbience()
	if worldState.ambience then
		if not ambCC then
			ambCC = Instance.new("ColorCorrectionEffect")
			ambCC.Name = "TB_Ambience"
			ambCC.Parent = Lighting
		end
		ambCC.TintColor = worldState.ambienceCfg.color
	elseif ambCC then
		ambCC:Destroy()
		ambCC = nil
	end
end

-- RTX Shaders: a cinematic post-process preset (bloom, sun rays, tone/contrast,
-- depth of field, atmosphere) over brighter, shadowed lighting. Not literal ray
-- tracing (impossible in vanilla Roblox) — a heavy reshade-style look.
local rtxFx = {}
local rtxAtmo = nil
local rtxOrig = nil
local function setRtx(on)
	if on then
		if rtxOrig then
			return
		end
		rtxOrig = {
			Brightness = Lighting.Brightness,
			ExposureCompensation = Lighting.ExposureCompensation,
			GlobalShadows = Lighting.GlobalShadows,
			EnvDiff = Lighting.EnvironmentDiffuseScale,
			EnvSpec = Lighting.EnvironmentSpecularScale,
		}
		pcall(function()
			Lighting.Brightness = 2.5
			Lighting.ExposureCompensation = 0.2
			Lighting.GlobalShadows = true
			Lighting.EnvironmentDiffuseScale = 1
			Lighting.EnvironmentSpecularScale = 1
		end)
		local function addFx(inst, props)
			for k, v in pairs(props) do
				inst[k] = v
			end
			inst.Parent = Lighting
			rtxFx[#rtxFx + 1] = inst
		end
		addFx(Instance.new("BloomEffect"), { Intensity = 0.9, Size = 32, Threshold = 0.85 })
		addFx(Instance.new("SunRaysEffect"), { Intensity = 0.16, Spread = 0.9 })
		addFx(Instance.new("ColorCorrectionEffect"), { Contrast = 0.18, Saturation = 0.22, Brightness = 0.02, TintColor = Color3.fromRGB(255, 248, 240) })
		addFx(Instance.new("DepthOfFieldEffect"), { FarIntensity = 0.12, FocusDistance = 35, InFocusRadius = 45, NearIntensity = 0.1 })
		-- only add our own Atmosphere if the game isn't already running one
		if not Lighting:FindFirstChildOfClass("Atmosphere") then
			rtxAtmo = Instance.new("Atmosphere")
			pcall(function()
				rtxAtmo.Density = 0.32
				rtxAtmo.Haze = 1.2
				rtxAtmo.Glare = 0.4
				rtxAtmo.Color = Color3.fromRGB(199, 209, 224)
			end)
			rtxAtmo.Parent = Lighting
		end
	else
		for _, fx in ipairs(rtxFx) do
			pcall(function()
				fx:Destroy()
			end)
		end
		rtxFx = {}
		if rtxAtmo then
			pcall(function()
				rtxAtmo:Destroy()
			end)
			rtxAtmo = nil
		end
		if rtxOrig then
			pcall(function()
				Lighting.Brightness = rtxOrig.Brightness
				Lighting.ExposureCompensation = rtxOrig.ExposureCompensation
				Lighting.GlobalShadows = rtxOrig.GlobalShadows
				Lighting.EnvironmentDiffuseScale = rtxOrig.EnvDiff
				Lighting.EnvironmentSpecularScale = rtxOrig.EnvSpec
			end)
			rtxOrig = nil
		end
	end
end

-- Low Detail (FPS): reversibly strip the expensive stuff — global shadows, post
-- effects, particles/trails/beams and decals/textures. Everything is tracked and
-- restored on toggle-off (and re-applied to newly-streamed parts while it's on).
local ldState = { effects = {}, particles = {}, decals = {}, shadows = nil }
local ldConn = nil
local function ldApplyTo(obj)
	if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
		if obj.Enabled and ldState.particles[obj] == nil then
			ldState.particles[obj] = true
			obj.Enabled = false
		end
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		if ldState.decals[obj] == nil then
			ldState.decals[obj] = obj.Transparency
			obj.Transparency = 1
		end
	end
end
local function setLowDetail(on)
	worldState.lowDetail = on
	if on then
		if ldState.shadows == nil then
			ldState.shadows = Lighting.GlobalShadows
		end
		pcall(function()
			Lighting.GlobalShadows = false
		end)
		for _, eff in ipairs(Lighting:GetChildren()) do
			if eff:IsA("PostEffect") and eff.Enabled then
				ldState.effects[eff] = true
				eff.Enabled = false
			end
		end
		for _, d in ipairs(Workspace:GetDescendants()) do
			pcall(ldApplyTo, d)
		end
		if not ldConn then
			ldConn = Workspace.DescendantAdded:Connect(function(d)
				if worldState.lowDetail then
					pcall(ldApplyTo, d)
				end
			end)
		end
	else
		if ldConn then
			ldConn:Disconnect()
			ldConn = nil
		end
		if ldState.shadows ~= nil then
			pcall(function()
				Lighting.GlobalShadows = ldState.shadows
			end)
			ldState.shadows = nil
		end
		for eff in pairs(ldState.effects) do
			pcall(function()
				eff.Enabled = true
			end)
		end
		ldState.effects = {}
		for pe in pairs(ldState.particles) do
			pcall(function()
				pe.Enabled = true
			end)
		end
		ldState.particles = {}
		for dec, t in pairs(ldState.decals) do
			pcall(function()
				dec.Transparency = t
			end)
		end
		ldState.decals = {}
	end
end

