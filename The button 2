-- ---- Item ESP: shader-highlight world items (workspace children with a
-- ToolType attribute), matching The Button's pickup structure ----
-- only itemEspConfig / updateItemEspColor / setItemEsp escape; scoped for registers
local itemEspConfig, updateItemEspColor, setItemEsp
do
local itemEspEnabled = false
itemEspConfig = { color = Color3.fromRGB(255, 255, 255), alpha = 0.7 } -- white base; gear-configurable
local itemObjects = {} -- [item] = { highlight, billboard, label, adornee }
local itemConn

local function isItem(obj)
	return obj:GetAttribute("ToolType") ~= nil
end

local function itemAdornee(obj)
	if obj:IsA("BasePart") then
		return obj
	end
	return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
end

local function highlightItem(obj)
	if itemObjects[obj] then
		return
	end
	local adornee = itemAdornee(obj)
	if not adornee then
		return
	end
	-- shader-style highlight (solid fill through walls, no outline edge)
	local hl = Instance.new("Highlight")
	hl.Adornee = obj
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillColor = itemEspConfig.color
	hl.FillTransparency = 1 - itemEspConfig.alpha
	hl.OutlineTransparency = 1
	hl.Parent = espGui
	-- name + distance label above the item
	local bb = Instance.new("BillboardGui")
	bb.Adornee = adornee
	bb.Size = UDim2.fromOffset(200, 20)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.AlwaysOnTop = true
	bb.Parent = espGui
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextColor3 = itemEspConfig.color
	label.TextStrokeTransparency = 0.4
	label.Text = obj.Name
	label.Parent = bb
	itemObjects[obj] = { highlight = hl, billboard = bb, label = label, adornee = adornee }
end

function updateItemEspColor()
	for _, o in pairs(itemObjects) do
		o.highlight.FillColor = itemEspConfig.color
		o.highlight.FillTransparency = 1 - itemEspConfig.alpha
		o.label.TextColor3 = itemEspConfig.color
	end
end

local function removeItem(obj)
	local o = itemObjects[obj]
	if o then
		o.highlight:Destroy()
		o.billboard:Destroy()
		itemObjects[obj] = nil
	end
end

local function clearItemHighlights()
	for obj in pairs(itemObjects) do
		removeItem(obj)
	end
end

function setItemEsp(on)
	itemEspEnabled = on
	if on then
		for _, obj in ipairs(Workspace:GetChildren()) do
			if isItem(obj) then
				highlightItem(obj)
			end
		end
		if not itemConn then
			itemConn = Workspace.ChildAdded:Connect(function(obj)
				if itemEspEnabled and isItem(obj) then
					highlightItem(obj)
				end
			end)
			table.insert(uisConnections, itemConn)
		end
	else
		clearItemHighlights()
	end
end

-- keep each item's distance label current; drop items that were collected
table.insert(uisConnections, RunService.Heartbeat:Connect(function()
	if not itemEspEnabled then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local myPos = hrp and hrp.Position
	for obj, o in pairs(itemObjects) do
		if not obj.Parent or not o.adornee.Parent then
			removeItem(obj)
		elseif myPos then
			local dist = math.floor((o.adornee.Position - myPos).Magnitude + 0.5)
			o.label.Text = obj.Name .. "  [" .. dist .. "m]"
			-- animate the highlight/label when Rainbow ESP is on
			if rainbowState.enabled then
				local c = espCol(itemEspConfig, strSeed(obj.Name))
				o.highlight.FillColor = c
				o.label.TextColor3 = c
			end
		end
	end
end))

screenGui.Destroying:Connect(clearItemHighlights)
end

-- ---- NPC ESP: highlight zombies (green) and guards (red). The Button's NPC
-- naming isn't documented, so classify by keyword; adjust the lists if needed.
-- Wrapped in a do-block; only the config + two entry points escape. ----
local npcEspConfig, setNpcEsp, updateNpcEspColor
do
	npcEspConfig = {
		Zombie = { enabled = false, color = Color3.fromRGB(255, 255, 255), alpha = 0.45 },
		Guard  = { enabled = false, color = Color3.fromRGB(255, 255, 255), alpha = 0.45 },
	}
	-- Zombies match these words (in the model name OR its parent folder name).
	-- EVERY other non-player NPC is treated as a Guard — they spawn after the
	-- Breach event with varied/unknown names, so a catch-all is the only reliable
	-- way to tag them. Turn on Guard ESP to see all of them (red); zombies show
	-- green. If a guard shows green (or a zombie red), read its name off the label
	-- and tell me which word to add.
	local ZOMBIE_WORDS = {
		"zombie", "zomb", "infected", "walker", "undead", "runner", "crawler",
		"husk", "ghoul", "monster", "creature", "mutant", "corpse",
	}
	local npcObjects = {} -- [model] = { highlight, billboard, label, category, adornee }

	local function matchesAny(name, words)
		for _, w in ipairs(words) do
			if name:find(w, 1, true) then
				return true
			end
		end
		return false
	end

	-- Guards/soldiers get their OWN keyword list so a shared parent folder (e.g.
	-- "Monsters"/"Enemies") can't mis-tag them as zombies, and so any unknown NPC
	-- defaults to Guard. A model's own name wins over its parent folder.
	local GUARD_WORDS = {
		"guard", "soldier", "trooper", "troop", "police", "cop", "officer",
		"enforcer", "sentry", "agent", "hunter", "seeker", "staff", "worker",
		"manager", "pink", "mask", "doll", "shooter", "gunman", "military", "bot",
	}

	-- a non-player NPC is a Zombie only if it clearly matches a zombie word;
	-- everything else (the catch-all) is a Guard, so guards can never be gated out
	local function classifyNpc(model)
		local n = model.Name:lower()
		if matchesAny(n, GUARD_WORDS) then
			return "Guard"
		end
		if matchesAny(n, ZOMBIE_WORDS) then
			return "Zombie"
		end
		local p = model.Parent
		local pn = p and p.Name:lower() or ""
		if matchesAny(pn, GUARD_WORDS) then
			return "Guard"
		end
		if matchesAny(pn, ZOMBIE_WORDS) then
			return "Zombie"
		end
		return "Guard" -- unknown NPCs default to Guard
	end

	local function npcAdornee(model)
		return model.PrimaryPart
			or model:FindFirstChild("HumanoidRootPart")
			or model:FindFirstChild("Torso")
			or model:FindFirstChildWhichIsA("BasePart")
	end

	local function removeNpc(model)
		local o = npcObjects[model]
		if o then
			o.highlight:Destroy()
			if o.billboard then
				o.billboard:Destroy()
			end
			npcObjects[model] = nil
		end
	end

	local function highlightNpc(model, category)
		if npcObjects[model] then
			return
		end
		local cfg = npcEspConfig[category]
		local hl = Instance.new("Highlight")
		hl.Adornee = model
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillColor = cfg.color
		hl.FillTransparency = 1 - cfg.alpha
		hl.OutlineColor = cfg.color
		hl.OutlineTransparency = 0
		hl.Parent = espGui
		local adornee = npcAdornee(model)
		local bb, label
		if adornee then
			bb = Instance.new("BillboardGui")
			bb.Adornee = adornee
			bb.Size = UDim2.fromOffset(150, 18)
			bb.StudsOffset = Vector3.new(0, 3, 0)
			bb.AlwaysOnTop = true
			bb.Parent = espGui
			label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.GothamBold
			label.TextSize = 13
			label.TextColor3 = cfg.color
			label.TextStrokeTransparency = 0.4
			label.Text = model.Name
			label.Parent = bb
		end
		npcObjects[model] = { highlight = hl, billboard = bb, label = label, category = category, adornee = adornee }
	end

	local function clearNpc(category)
		for model, o in pairs(npcObjects) do
			if not category or o.category == category then
				removeNpc(model)
			end
		end
	end

	-- character-rig part names — lets us find NPCs that spawn without a standard
	-- Humanoid or with an oddly-named root (some guard rigs do)
	local CHAR_PARTS = {
		HumanoidRootPart = true, Torso = true, UpperTorso = true, LowerTorso = true,
		Root = true, RootPart = true, Head = true,
	}
	-- walk up to the nearest Model ancestor (the rig may be nested a level or two)
	local function nearestModel(inst)
		local m = inst
		while m and m ~= Workspace do
			if m:IsA("Model") then
				return m
			end
			m = m.Parent
		end
		return nil
	end
	-- a genuine character rig: has a Humanoid, or a Head plus a torso/root part
	-- (keeps map geometry / props from being highlighted)
	local function isCharacterModel(model)
		if model:FindFirstChildOfClass("Humanoid") then
			return true
		end
		if not model:FindFirstChild("Head") then
			return false
		end
		return model:FindFirstChild("HumanoidRootPart") ~= nil
			or model:FindFirstChild("Torso") ~= nil
			or model:FindFirstChild("UpperTorso") ~= nil
			or model:FindFirstChild("LowerTorso") ~= nil
			or model:FindFirstChild("Root") ~= nil
			or model:FindFirstChild("RootPart") ~= nil
	end

	local function scanNpcs()
		if not (npcEspConfig.Zombie.enabled or npcEspConfig.Guard.enabled) then
			return
		end
		local myChar = player.Character
		local function consider(inst)
			local model = nearestModel(inst)
			if not model or npcObjects[model] then
				return
			end
			if model == myChar or Players:GetPlayerFromCharacter(model) then
				return
			end
			if not isCharacterModel(model) then
				return
			end
			local cat = classifyNpc(model)
			if npcEspConfig[cat].enabled then
				highlightNpc(model, cat)
			end
		end
		-- detect by a Humanoid OR by any character-rig part, so guards that spawn
		-- with a non-standard rig are still found (the same way zombies are)
		for _, d in ipairs(Workspace:GetDescendants()) do
			if d:IsA("Humanoid") then
				consider(d.Parent)
			elseif d:IsA("BasePart") and CHAR_PARTS[d.Name] then
				consider(d)
			end
		end
	end

	function updateNpcEspColor()
		for _, o in pairs(npcObjects) do
			local cfg = npcEspConfig[o.category]
			o.highlight.FillColor = cfg.color
			o.highlight.FillTransparency = 1 - cfg.alpha
			o.highlight.OutlineColor = cfg.color
			if o.label then
				o.label.TextColor3 = cfg.color
			end
		end
	end

	function setNpcEsp(category, on)
		npcEspConfig[category].enabled = on
		if on then
			scanNpcs()
		else
			clearNpc(category)
		end
	end

	-- periodic scan for new NPCs + cleanup of gone ones + live distance labels
	local scanAccum = 0
	table.insert(uisConnections, RunService.Heartbeat:Connect(function(dt)
		-- drop highlights whose model left or whose category was turned off
		for model, o in pairs(npcObjects) do
			if not model.Parent or not npcEspConfig[o.category].enabled then
				removeNpc(model)
			end
		end
		if not (npcEspConfig.Zombie.enabled or npcEspConfig.Guard.enabled) then
			return
		end
		scanAccum = scanAccum + dt
		if scanAccum >= 1.5 then
			scanAccum = 0
			scanNpcs()
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local myPos = hrp and hrp.Position
		if myPos then
			for model, o in pairs(npcObjects) do
				if o.label and o.adornee and o.adornee.Parent then
					local dist = math.floor((o.adornee.Position - myPos).Magnitude + 0.5)
					o.label.Text = model.Name .. "  [" .. dist .. "m]"
				end
				-- animate highlight + label when Rainbow ESP is on
				if rainbowState.enabled and o.highlight then
					local c = espCol(npcEspConfig[o.category], strSeed(model.Name))
					o.highlight.FillColor = c
					o.highlight.OutlineColor = c
					if o.label then
						o.label.TextColor3 = c
					end
				end
			end
		end
	end))

	screenGui.Destroying:Connect(function()
		clearNpc(nil)
	end)
end

local function buildVisualsPage(page)
	local body = makeScrollBody(page, 470)

	-- master player-ESP row: toggle + an expand arrow that collapses the element
	-- list (Box/Shader/…). No section headers — the groups just sit flat under it.
	local espRow = makeToggle(body, 6, "Player ESP", false, function(on)
		espEnabled = on
		refreshPreview()
	end, 34)

	local arrow = Instance.new("TextButton")
	arrow.AnchorPoint = Vector2.new(1, 0.5)
	arrow.Position = UDim2.new(1, 0, 0.5, 0)
	arrow.Size = UDim2.fromOffset(22, 22)
	arrow.BackgroundTransparency = 1
	arrow.Text = ""
	arrow.AutoButtonColor = false
	arrow.Parent = espRow

	-- downward chevron drawn from two bars (a text glyph shows as a tofu box)
	local function chevBar(rot, xoff)
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = UDim2.new(0.5, xoff, 0.5, 0)
		b.Size = UDim2.fromOffset(10, 2.5)
		b.Rotation = rot
		b.BackgroundColor3 = Color3.fromRGB(190, 190, 205)
		b.BorderSizePixel = 0
		b.Parent = arrow
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = b
	end
	chevBar(45, -3)
	chevBar(-45, 3)

	-- collapsible container for the player-ESP element rows (gear only when the
	-- element has a colour; Health uses an HP gradient, so no gear)
	local ROW_H = 36
	local container = Instance.new("Frame")
	container.Position = UDim2.new(0, 14, 0, 44)
	container.Size = UDim2.new(1, -14, 0, 0)
	container.BackgroundTransparency = 1
	container.ClipsDescendants = true
	container.Parent = body

	for i, name in ipairs(ESP_ORDER) do
		local cfg = espConfig[name]
		local row = makeToggle(container, (i - 1) * ROW_H, name, cfg.enabled, function(on)
			cfg.enabled = on
			refreshPreview()
		end, 34)
		if cfg.gear then
			makeGear(row, cfg, refreshPreview)
		end
	end

	-- Item / NPC / Rainbow toggles — flat, no headers; slides down when the
	-- player-ESP accordion opens
	local belowGroup = Instance.new("Frame")
	belowGroup.Position = UDim2.new(0, 0, 0, 48)
	belowGroup.Size = UDim2.new(1, 0, 0, 0)
	belowGroup.BackgroundTransparency = 1
	belowGroup.Parent = body

	local itemRow = makeToggle(belowGroup, 0, "Item ESP", false, function(on)
		setItemEsp(on)
	end, 34)
	makeGear(itemRow, itemEspConfig, updateItemEspColor)

	local zombieRow = makeToggle(belowGroup, 36, "Zombie ESP", false, function(on)
		setNpcEsp("Zombie", on)
	end, 34)
	makeGear(zombieRow, npcEspConfig.Zombie, updateNpcEspColor)

	local guardRow = makeToggle(belowGroup, 72, "Guard ESP", false, function(on)
		setNpcEsp("Guard", on)
