-- ---- silent aim (raycast redirect) ----
-- The Button uses raycast-based hit detection, so silent aim hooks the ray
-- methods (workspace:Raycast / FindPartOnRay*) and Mouse.Hit/Target and
-- redirects them at the nearest player to the crosshair. Adapted from the
-- Universal Silent Aim by Averiias / Stefanuk12 / xaxa.
local silentSupported = typeof(hookmetamethod) == "function"
	and typeof(getnamecallmethod) == "function"
	and typeof(newcclosure) == "function"

-- genv + silentState were declared near the top of this do-block (so kill aura
-- can reach silentState.forcedTarget); just initialise the rest of the state here
silentState.enabled = false -- always start disabled on a fresh menu
silentState.fov = silentState.fov or 250
silentState.targetPart = silentState.targetPart or "HumanoidRootPart"
silentState.teamCheck = false
silentState.visibleCheck = false
silentState.showTarget = false -- highlight whoever silent aim is locked onto
silentState.targetLock = false -- Target Lock feature (start off on a fresh menu)
silentState.lockedPlayer = nil -- the Player the lock has committed to (persists until off)
-- default to Mouse: the user confirmed this game reads Mouse.Hit for aiming
silentState.method = silentState.method or "Mouse"

local svCheckcaller = (typeof(checkcaller) == "function") and checkcaller or function()
	return false
end
local silentMouse = player:GetMouse()

-- nearest player to the mouse (within FOV), returns the chosen target part
local function silentClosestPlayer()
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil
	end
	local mousePos = UserInputService:GetMouseLocation()
	local closest, closestDist
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and not (silentState.teamCheck and isTeammate(plr)) then
			local char, _, root = aliveTarget(plr)
			if char then
				-- WorldToViewportPoint (not WorldToScreenPoint) so it matches
				-- GetMouseLocation's space — both exclude the GUI inset
				local sp, onScreen = camera:WorldToViewportPoint(root.Position)
				if onScreen then
					local dist = (mousePos - Vector2.new(sp.X, sp.Y)).Magnitude
					if dist <= silentState.fov and (not closestDist or dist < closestDist) then
						local visible = true
						if silentState.visibleCheck then
							local ignore = { char }
							if player.Character then
								table.insert(ignore, player.Character)
							end
							visible = #camera:GetPartsObscuringTarget({ root.Position }, ignore) == 0
						end
						if visible then
							closest = char:FindFirstChild(silentState.targetPart) or root
							closestDist = dist
						end
					end
				end
			end
		end
	end
	return closest
end

-- keep the caller's original ray length so we don't turn a short camera/ground
-- ray into a 1000-stud ray (which is what bugged the camera)
local function silentDirection(origin, pos, len)
	return (pos - origin).Unit * (len or 1000)
end

-- ---- Target Lock ----
-- resolve the locked player's current aim part. Returns nil while they're dead or
-- have left — silent aim then simply doesn't redirect that frame, honouring "only
-- them until toggled off" (no silent fall-back to the nearest player).
local function lockedTargetPart()
	local plr = silentState.lockedPlayer
	if not (plr and plr.Parent) then
		return nil
	end
	local char = aliveTarget(plr)
	if not char then
		return nil
	end
	return char:FindFirstChild(silentState.targetPart) or char:FindFirstChild("HumanoidRootPart")
end

-- the single place that decides who silent aim hits: a forced target (kill aura /
-- spinbot swing) wins, then a committed Target-Lock player, else nearest-to-crosshair
local function silentPickTarget()
	if silentState.forcedTarget then
		return silentState.forcedTarget
	end
	if silentState.targetLock and silentState.lockedPlayer then
		return lockedTargetPart()
	end
	return silentClosestPlayer()
end

-- Show Silent Aim Target: a highlight on whoever silent aim would currently hit
-- (the same target the hook redirects onto), so you can see the lock. Uses a
-- single reused Highlight, throttled so it isn't a per-target scan every frame.
local silentTargetHl = Instance.new("Highlight")
silentTargetHl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
silentTargetHl.FillColor = Color3.fromRGB(255, 230, 40)
silentTargetHl.FillTransparency = 0.55
silentTargetHl.OutlineColor = Color3.fromRGB(255, 230, 40)
silentTargetHl.OutlineTransparency = 0
silentTargetHl.Enabled = false
silentTargetHl.Parent = espGui
do
	local acc = 0
	table.insert(uisConnections, RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.05 then
			return
		end
		acc = 0
		-- stand down while Target Lock is on — it paints its own highlights
		if silentState.enabled and silentState.showTarget and not silentState.targetLock then
			local part = silentClosestPlayer()
			local model = part and part.Parent
			if model then
				silentTargetHl.Adornee = model
				silentTargetHl.Enabled = true
			else
				silentTargetHl.Enabled = false
			end
		elseif silentTargetHl.Enabled then
			silentTargetHl.Enabled = false
		end
	end))
end

-- Target Lock loop: hold your crosshair on ONE enemy for LOCK_TIME continuous
-- seconds to lock it. Only ONE target is ever highlighted (never all players): the
-- enemy you're currently aiming at glows YELLOW while the lock charges, and once it
-- commits it turns RED — from then on silentPickTarget returns only that player until
-- you toggle Target Lock off. The lock survives their death/respawn (drops only if
-- they leave the game).
local LOCK_YELLOW = Color3.fromRGB(255, 230, 40)
local LOCK_RED = Color3.fromRGB(255, 45, 45)
local LOCK_TIME = 4
do
	local candidate, candTimer = nil, 0
	local lockHl = Instance.new("Highlight")
	lockHl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	lockHl.FillTransparency = 0.55
	lockHl.OutlineTransparency = 0
	lockHl.Enabled = false
	lockHl.Parent = espGui
	local function paint(char, col)
		lockHl.Adornee = char
		lockHl.FillColor = col
		lockHl.OutlineColor = col
		lockHl.Enabled = true
	end
	local acc = 0
	table.insert(uisConnections, RunService.Heartbeat:Connect(function(dt)
		-- Target Lock only works while Silent Aim is ON (clears + releases otherwise)
		if not (silentState.enabled and silentState.targetLock) then
			if lockHl.Enabled then
				lockHl.Enabled = false
			end
			candidate, candTimer = nil, 0
			silentState.lockedPlayer = nil
			return
		end
		acc = acc + dt
		if acc < 0.05 then
			return
		end
		local elapsed = acc
		acc = 0
		-- drop the lock only if that player left the game entirely (not on death)
		local locked = silentState.lockedPlayer
		if locked and not locked.Parent then
			silentState.lockedPlayer = nil
			locked = nil
		end
		-- already locked: keep the RED highlight on that player wherever you aim. If
		-- they DIE, release the lock so it re-acquires someone else THIS tick without
		-- you having to toggle Target Lock off.
		if locked then
			local char = aliveTarget(locked)
			if char then
				paint(char, LOCK_RED)
				return
			end
			silentState.lockedPlayer = nil
			candidate, candTimer = nil, 0
			lockHl.Enabled = false
			-- fall through to acquisition below
		end
		-- acquiring: highlight ONLY the enemy under your crosshair (yellow) and count
		-- up while it stays the same one; commit to a lock at LOCK_TIME seconds
		local part = silentClosestPlayer()
		local aimed = part and part.Parent and Players:GetPlayerFromCharacter(part.Parent)
		if aimed then
			if aimed == candidate then
				candTimer = candTimer + elapsed
			else
				candidate, candTimer = aimed, elapsed
			end
			if candTimer >= LOCK_TIME then
				silentState.lockedPlayer = aimed
				candidate, candTimer = nil, 0
				paint(aimed.Character, LOCK_RED)
			else
				paint(aimed.Character, LOCK_YELLOW)
			end
		else
			candidate, candTimer = nil, 0
			lockHl.Enabled = false
		end
	end))
end

-- Decide whether to redirect a ray. Camera-occlusion rays (top-down: they point
-- UP at the raised camera) and tiny ground/step rays are always left alone, or
-- the camera freezes and the character drifts. Plain silent aim only touches the
-- long weapon shot ray (>=20 studs); when kill aura has forced a target it also
-- redirects the shorter melee swing ray (>=6) so the swing lands from any angle.
local function shouldRedirect(dir)
	local floor = silentState.forcedTarget and 6 or 20
	if dir.Magnitude < floor then
		return false
	end
	if dir.Unit.Y > 0.35 then
		return false
	end
	return true
end

-- install the hooks once per client session (survive re-execution via the
-- getgenv flag; they read the shared silentState so a fresh menu still drives
-- the already-installed hooks)
if silentSupported and not (genv and genv.TheButtonSilentHooked) then
	if genv then
		genv.TheButtonSilentHooked = true
	end

	local oldNamecall, oldIndex
	-- pcall the installs: some executors pass the typeof(hookmetamethod)=="function"
	-- check but THROW when actually hooking, which would otherwise halt the whole
	-- script before the UI builds. On failure silent aim is simply disabled.
	local hooksOk = pcall(function()
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
		local args = { ... }
		local self = args[1]
		if (silentState.enabled or silentState.forcedTarget) and not svCheckcaller() then
			local okm, method = pcall(getnamecallmethod)
			if okm and method == silentState.method then
				-- raycasts may run on workspace OR any WorldRoot (e.g. a WorldModel)
				local isWR = typeof(self) == "Instance" and (self == workspace or self:IsA("WorldRoot"))
				if method == "Raycast" and isWR and typeof(args[2]) == "Vector3" and typeof(args[3]) == "Vector3" then
					if shouldRedirect(args[3]) then
						local hit = silentPickTarget()
						if hit then
							args[3] = silentDirection(args[2], aimPos(hit), args[3].Magnitude)
							return oldNamecall(table.unpack(args))
						end
					end
				elseif (method == "Blockcast" or method == "Spherecast" or method == "Shapecast")
					and isWR and typeof(args[4]) == "Vector3" then
					-- direction is arg4; origin is arg2 (a CFrame for Blockcast, Vector3 for Spherecast)
					if shouldRedirect(args[4]) then
						local hit = silentPickTarget()
						local origin = (typeof(args[2]) == "CFrame") and args[2].Position or args[2]
						if hit and typeof(origin) == "Vector3" then
							args[4] = silentDirection(origin, aimPos(hit), args[4].Magnitude)
							return oldNamecall(table.unpack(args))
						end
					end
				elseif (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList"
					or method == "FindPartOnRayWithWhitelist") and isWR and typeof(args[2]) == "Ray" then
					if shouldRedirect(args[2].Direction) then
						local hit = silentPickTarget()
						if hit then
							local origin = args[2].Origin
							args[2] = Ray.new(origin, silentDirection(origin, aimPos(hit), args[2].Direction.Magnitude))
							return oldNamecall(table.unpack(args))
						end
					end
				elseif method == "FireServer" and typeof(self) == "Instance" and self:IsA("RemoteEvent") then
					-- remote-based weapon: swap hit position / CFrame / target-instance args
					local hit = silentPickTarget()
					if hit then
						local pos = aimPos(hit)
						local tchar = hit.Parent
						local changed = false
						for i = 2, #args do
							local a = args[i]
							local t = typeof(a)
							if t == "Vector3" then
								args[i] = pos
								changed = true
							elseif t == "CFrame" then
								args[i] = CFrame.new(pos)
								changed = true
							elseif t == "Instance" and a:IsA("Model") and Players:GetPlayerFromCharacter(a) then
								args[i] = tchar
								changed = true
							end
						end
						if changed then
							return oldNamecall(table.unpack(args))
						end
					end
				end
			end
		end
		return oldNamecall(...)
	end))

	oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, index)
		if (silentState.enabled or silentState.forcedTarget) and self == silentMouse and not svCheckcaller() and silentState.method == "Mouse" then
			local hit = silentPickTarget()
			if hit then
				if index == "Target" or index == "target" then
					return hit
				elseif index == "Hit" or index == "hit" then
					return CFrame.new(aimPos(hit))
				end
			end
		end
		return oldIndex(self, index)
	end))
	end)
	if not hooksOk then
		-- executor accepted the typeof check but the hook threw; disable the hook
		-- features so the rest of the menu still loads
		silentSupported = false
	end
end

-- ============================================================
-- Gun Mods engine (all client-side, verified against the decompiled LocalGunModule):
--   No Recoil   — RecoilFunction only rotates YOUR camera; t2[gun].Recoil = 0 → no kick.
--   No Spread   — the shot's hit point is already the exact crosshair (client-decided,
--                 the same channel silent aim exploits); we pin the crosshair tight
--                 (t2[gun].Spread = 0) and force the Fire remote's aiming=true /
--                 walkspeed=0 args so the server applies its minimum spread cone.
--   Rapid Fire  — the fire loop is a client task.wait(ShootDelay); shrink ShootDelay.
--   Fast Reload — reload is a client AnimationTrack; speeding it up fires the refill
--                 marker (Tool.Reload:FireServer()) sooner.
-- t2 is the module's shared per-gun config upvalue: editing it affects every gun and
-- every future equip. Per-equip state objects carry the reload AnimationTracks.
-- Wrapped in a function so its locals get their OWN 200-register space instead of
-- piling onto the already-near-limit combat do-block.
do
	local function initGunEngine()
	local canGC = typeof(getgc) == "function"
	local GUN_KEYS = { "L106", "AK-74M", "AS-VAL", "M4A1", "CS5", "M27", "Minigun" }
	local t2, origStats

	local function findT2()
		if t2 or not canGC then
			return t2
		end
		for _, v in ipairs(getgc(true)) do
			if type(v) == "table" then
				local ok, hit = pcall(function()
					local g = rawget(v, "L106") or rawget(v, "Minigun")
					return type(g) == "table" and type(rawget(g, "ShootDelay")) == "number"
						and rawget(g, "Recoil") ~= nil and rawget(g, "Spread") ~= nil
				end)
				if ok and hit then
					t2 = v
					break
				end
			end
		end
		if t2 and not origStats then
			origStats = {}
			for _, g in ipairs(GUN_KEYS) do
				local cfg = rawget(t2, g)
				if type(cfg) == "table" then
					origStats[g] = { Recoil = cfg.Recoil, ShootDelay = cfg.ShootDelay, Spread = cfg.Spread, ShootType = cfg.ShootType }
				end
			end
		end
		return t2
	end

	local function applyStats()
		local cfg = findT2()
		if not (cfg and origStats) then
			return
		end
		for g, orig in pairs(origStats) do
			local gc = rawget(cfg, g)
			if type(gc) == "table" then
				gc.Recoil = gunMods.noRecoil and 0 or orig.Recoil
				gc.Spread = gunMods.noSpread and 0 or orig.Spread
				gc.ShootDelay = gunMods.rapidFire and math.max(0.01, gunMods.rapidMs / 1000) or orig.ShootDelay
				-- force full-auto while Rapid Fire is on so single-shot guns (L106/CS5)
				-- actually repeat when you hold fire; restore the real type when off
				gc.ShootType = gunMods.rapidFire and "Auto" or orig.ShootType
			end
		end
	end

	-- per-equip gun state objects: tables with an AttemptShoot function + a Reload
	-- AnimationTrack. Refreshed occasionally so new equips are picked up.
	local states = {}
	local function refreshStates()
		if not canGC then
			return
		end
		local out = {}
		for _, v in ipairs(getgc(true)) do
			if type(v) == "table" then
				local ok, isState = pcall(function()
					return type(rawget(v, "AttemptShoot")) == "function" and rawget(v, "Reload") ~= nil
				end)
				if ok and isState then
					out[#out + 1] = v
				end
			end
		end
		states = out
	end

	local function setReloadSpeed(spd)
		for _, st in ipairs(states) do
			pcall(function()
				-- only adjust a track while it's PLAYING: Play() resets speed to 1x each
				-- reload, and AdjustSpeed on a stopped track can throw. Boosting mid-play
				-- makes the "Reload" marker (which fires Tool.Reload:FireServer) hit sooner.
				local r = rawget(st, "Reload")
				if r and r.IsPlaying and math.abs((r.Speed or 1) - spd) > 0.01 then
					r:AdjustSpeed(spd)
				end
				local vr = rawget(st, "ViewmodelReload")
				if vr and vr.IsPlaying and math.abs((vr.Speed or 1) - spd) > 0.01 then
					vr:AdjustSpeed(spd)
				end
			end)
		end
	end

	-- install the driving loop once per session (persisted so re-paste doesn't stack
	-- Heartbeat loops); it reads the persistent gunMods table, so a fresh menu drives
	-- the already-installed loop.
	if not (genv and genv.NeverWinGunLoop) then
		if genv then
			genv.NeverWinGunLoop = true
		end
		local statAcc, stateAcc, everMod, reloadWasOn = 0, 999, false, false
		local conn = RunService.Heartbeat:Connect(function(dt)
			-- stat mods (recoil / spread / rate) written to the shared t2
			statAcc = statAcc + dt
			if statAcc >= 0.1 then
				statAcc = 0
				local anyStat = gunMods.noRecoil or gunMods.noSpread or gunMods.rapidFire
				if anyStat or everMod then
					applyStats()
					everMod = anyStat
				end
			end
			-- fast reload / fast equip both need the per-equip state objects
			if gunMods.fastReload or gunMods.fastEquip then
				stateAcc = stateAcc + dt
				if stateAcc >= 1.5 then
					stateAcc = 0
					refreshStates()
				end
			end
			-- fast reload: boost the reload AnimationTrack (restore to 1x when off)
			if gunMods.fastReload then
				setReloadSpeed(math.max(1, gunMods.reloadSpeed))
				reloadWasOn = true
			elseif reloadWasOn then
				setReloadSpeed(1)
				reloadWasOn = false
			end
			-- fast equip: clear the Equipping flag so you can fire the instant you
			-- draw a weapon (shooting is gated on `not p1.Equipping`)
			if gunMods.fastEquip then
				for _, st in ipairs(states) do
					pcall(function()
						st.Equipping = false
					end)
				end
			end
		end)
		if genv then
			genv.NeverWinGunConn = conn
		else
			table.insert(uisConnections, conn)
		end
	end

	-- No Spread's server component: force aiming=true / walkspeed=0 on the gun's Fire
	-- remote so the server applies its minimum spread cone. Own once-per-session hook.
	if silentSupported and not (genv and genv.NeverWinGunHook) then
		if genv then
			genv.NeverWinGunHook = true
		end
		local prevGunNC
		prevGunNC = hookmetamethod(game, "__namecall", newcclosure(function(...)
			if gunMods.noSpread and not svCheckcaller() then
				local okm, method = pcall(getnamecallmethod)
				if okm and method == "FireServer" then
					local args = { ... }
					local self = args[1]
					-- gun fire: FireServer(true, Vector3 hitPos, aiming(bool), walkspeed(number))
					if typeof(self) == "Instance" and self.Name == "Fire"
						and args[2] == true and typeof(args[3]) == "Vector3"
						and typeof(args[4]) == "boolean" and typeof(args[5]) == "number" then
						args[4] = true
						args[5] = 0
						return prevGunNC(table.unpack(args))
					end
				end
			end
			return prevGunNC(...)
		end))
	end
	end
	-- pcall so a hook/getgc quirk on some executors can't halt the UI build
	pcall(initGunEngine)
end


