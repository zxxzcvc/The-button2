-- ---- hitbox expander ----
-- NOTE: this is client-side only. It enlarges other players' hit parts on
-- YOUR client, which helps when the game does hit detection on the client
-- (client raycasts / reports hits). If the game validates hits on the server
-- using real positions, no client-side size change can help — use silent aim.
local hitboxOriginals = {} -- [BasePart] = { size = Vector3, transparency = number }

local function restoreAllHitboxes()
	for part, orig in pairs(hitboxOriginals) do
		if part and part.Parent then
			part.Size = orig.size
			part.Transparency = orig.transparency
			part.CanCollide = orig.canCollide
		end
		hitboxOriginals[part] = nil
	end
end

local function expandPart(part, size)
	if not part then
		return
	end
	if not hitboxOriginals[part] then
		hitboxOriginals[part] = { size = part.Size, transparency = part.Transparency, canCollide = part.CanCollide }
	end
	part.Size = Vector3.new(size, size, size)
	part.CanCollide = false
	part.Transparency = 0.6
end

