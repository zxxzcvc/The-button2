-- Anti-fling: zero the root's spin each physics step (flings work by spinning
-- your HumanoidRootPart) and kill absurd velocity spikes, without touching
-- normal movement / fly speeds.
table.insert(uisConnections, RunService.Stepped:Connect(function()
	if not playerState.antiFling then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyAngularVelocity = Vector3.zero
		if hrp.AssemblyLinearVelocity.Magnitude > 250 then
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	end
end))

-- Click Teleport: press the bound key to teleport to wherever your mouse points.
-- (A key, not Ctrl+click — Ctrl is the game's shift-lock.) Rebind in Teleport tab.
local clickTpMouse = player:GetMouse()
local clickTpKey = Enum.KeyCode.T -- default; rebindable
local clickTpListening = false
local clickTpKeyBtn -- assigned when the Teleport page builds
local function clickTpKeyName()
	return (typeof(clickTpKey) == "EnumItem") and clickTpKey.Name or "None"
end
table.insert(uisConnections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	if clickTpListening then
		clickTpListening = false
		if input.KeyCode ~= Enum.KeyCode.Escape then
			clickTpKey = input.KeyCode
		end
		if clickTpKeyBtn then
			clickTpKeyBtn.Text = clickTpKeyName()
		end
		return
	end
	if gameProcessed then
		return
	end
	if playerState.clickTp and input.KeyCode == clickTpKey then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp and clickTpMouse.Target then
			hrp.CFrame = CFrame.new(clickTpMouse.Hit.Position + Vector3.new(0, 3, 0))
		end
	end
end))

-- Click TP "tp" tool: while Click TP is on, a Tool named "tp" sits in your
-- inventory. Equip it and tap/click where you want to go — the mobile-friendly
-- way (desktop can still Ctrl+click). Re-added after each respawn.
local tpTool = nil
local function removeTpTool()
	if tpTool then
		tpTool:Destroy()
		tpTool = nil
	end
end
local function makeTpTool()
	removeTpTool()
	local bp = player:FindFirstChildOfClass("Backpack")
	if not bp then
		return
	end
	tpTool = Instance.new("Tool")
	tpTool.Name = "tp"
	tpTool.RequiresHandle = false
	tpTool.CanBeDropped = false
	tpTool.ToolTip = "Tap where you want to teleport"
	tpTool.Activated:Connect(function()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hit = clickTpMouse.Hit
		if hrp and hit then
			hrp.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3, 0))
		end
	end)
	tpTool.Parent = bp
end
local function applyClickTp(on)
	playerState.clickTp = on
	if on then
		makeTpTool()
	else
		removeTpTool()
	end
end
-- re-add the tool after respawn while Click TP stays on
table.insert(uisConnections, player.CharacterAdded:Connect(function()
	task.spawn(function()
		local bp = player:WaitForChild("Backpack", 5)
		if bp and playerState.clickTp then
			makeTpTool()
		end
	end)
end))
screenGui.Destroying:Connect(removeTpTool)

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

-- Speed: pin WalkSpeed to the chosen value every frame so the game can't reset
-- it, and it survives respawns via the live humanoid.
table.insert(uisConnections, RunService.Heartbeat:Connect(function()
	if not playerState.speedEnabled then
		return
	end
	local hum = getHumanoid()
	if hum then
		hum.WalkSpeed = playerState.speed
	end
end))

-- Noclip: clear collision on the local character's parts each physics step
table.insert(uisConnections, RunService.Stepped:Connect(function()
	if not playerState.noclip then
		return
	end
	local char = player.Character
	if not char then
		return
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			d.CanCollide = false
		end
	end
end))

-- Infinite jump: re-trigger the jump state on every jump request mid-air
table.insert(uisConnections, UserInputService.JumpRequest:Connect(function()
