-- alive/targetable check shared by aimbot + silent aim. This game keeps
-- Humanoid.Health > 0 on some eliminations, so Health alone leaves dead players
-- targetable/shown — also reject the Dead humanoid state, a ragdolled
-- (PlatformStand) body, and common dead/eliminated flags. Returns char, hum, root
-- when the player is a live target, else nil.
local function aliveTarget(plr)
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (char and hum and root and hum.Health > 0) then
		return nil
	end
	if hum:GetState() == Enum.HumanoidStateType.Dead or hum.PlatformStand then
		return nil
	end
	if char:GetAttribute("Dead") or char:GetAttribute("Eliminated")
		or plr:GetAttribute("Dead") or plr:GetAttribute("Eliminated") then
		return nil
	end
	return char, hum, root
end

-- ---- aimbot ----
local function isAimKeyDown()
	local k = combatState.aimKey
	if typeof(k) ~= "EnumItem" then
		return false
	end
	if k.EnumType == Enum.KeyCode then
		return UserInputService:IsKeyDown(k)
	elseif k.EnumType == Enum.UserInputType then
		return UserInputService:IsMouseButtonPressed(k)
	end
	return false
end

local function getAimTarget(camera)
	local center = camera.ViewportSize / 2
	local best, bestDist
	local partName = combatState.aimHead and "Head" or "HumanoidRootPart"
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and not (combatState.aimTeamCheck and isTeammate(plr)) then
			local char = aliveTarget(plr)
			local part = char and char:FindFirstChild(partName)
			if part then
				local sp = camera:WorldToViewportPoint(part.Position)
				if sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if d <= combatState.aimFov and (not bestDist or d < bestDist)
						and (not combatState.aimWallCheck or visibleFromCamera(camera, part, char)) then
						best = part
						bestDist = d
					end
				end
			end
		end
	end
	return best
end

-- ---- backtrack: aim at where a target WAS (backtrackTime ms ago) ----
-- Records each enemy's recent HumanoidRootPart positions; aimPos(part) shifts the
-- part's CURRENT position back by how far the character has moved since then, so a
-- shot lands on the target's past hitbox. This ONLY lands hits if the server does
-- lag compensation (credits hits on recent positions); otherwise it aims behind.
local backtrackHistory = {} -- [player] = { {t, pos}, ... } oldest first
table.insert(uisConnections, RunService.Heartbeat:Connect(function()
	if not combatState.backtrack then
		if next(backtrackHistory) then
			backtrackHistory = {}
		end
		return
	end
	local now = os.clock()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local h = backtrackHistory[plr]
				if not h then
					h = {}
					backtrackHistory[plr] = h
				end
				h[#h + 1] = { t = now, pos = hrp.Position }
				while h[1] and now - h[1].t > 1 do
					table.remove(h, 1)
				end
			end
		end
	end
end))

-- the aim position for a target part, rewound in time when backtrack is on
local function aimPos(part)
	if not part then
		return nil
	end
	if not combatState.backtrack then
		return part.Position
	end
	local char = part.Parent
	local plr = char and Players:GetPlayerFromCharacter(char)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local h = plr and backtrackHistory[plr]
	if not (h and hrp and #h > 0) then
		return part.Position
	end
	local target = os.clock() - combatState.backtrackTime / 1000
	local best = h[1]
	for i = 1, #h do
		if h[i].t <= target then
			best = h[i]
		else
			break
		end
	end
	return part.Position + (best.pos - hrp.Position)
end

-- Backtrack indicator: a faint TRAIL of "ghost" bodies marking the target's recent
-- positions across the WHOLE Backtrack (ms) window — one ghost per sample, and more
-- of them the higher the ms (e.g. ~10 around 300ms). Very faint; older = fainter.
-- Updates every frame so you can see exactly how much it's tracking.
do
	local ghosts = {} -- [player] = { Part, Part, ... }
	local function clearFor(plr)
		local pool = ghosts[plr]
		if pool then
			for _, g in ipairs(pool) do
				pcall(function()
					g:Destroy()
				end)
			end
			ghosts[plr] = nil
		end
	end
	local function clearAll()
		for plr in pairs(ghosts) do
			clearFor(plr)
		end
	end
	local function newGhost()
		local g = Instance.new("Part")
		g.Name = "TB_Backtrack"
		g.Anchored = true
		g.CanCollide = false
		g.CanQuery = false
		g.Massless = true
		g.Size = Vector3.new(2, 4.8, 1)
		g.Color = Color3.fromRGB(255, 60, 70)
		g.Material = Enum.Material.Neon
		g.Parent = Workspace
		return g
	end
	-- closest recorded position at/before time t
	local function histPosAt(h, t)
		local best = h[1]
		for i = 1, #h do
			if h[i].t <= t then
				best = h[i]
			else
				break
			end
		end
		return best and best.pos
	end
	screenGui.Destroying:Connect(clearAll)
	table.insert(uisConnections, RunService.RenderStepped:Connect(function()
		if not combatState.backtrack then
			if next(ghosts) then
				clearAll()
			end
			return
		end
		local now = os.clock()
		local win = combatState.backtrackTime / 1000
		local N = math.clamp(math.floor(combatState.backtrackTime / 30 + 0.5), 3, 16)
		local seen = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local char = plr.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local h = backtrackHistory[plr]
				if char and hum and hrp and hum.Health > 0 and h and #h > 0 then
					seen[plr] = true
					local pool = ghosts[plr]
					if not pool then
						pool = {}
						ghosts[plr] = pool
					end
					while #pool < N do
						pool[#pool + 1] = newGhost()
					end
					while #pool > N do
						local g = table.remove(pool)
						pcall(function()
							g:Destroy()
						end)
					end
					local look = hrp.CFrame.LookVector
					for i = 1, N do
						local f = (N == 1) and 0 or (i - 1) / (N - 1)
						local pos = histPosAt(h, now - f * win) or hrp.Position
						local g = pool[i]
						g.CFrame = CFrame.new(pos, pos + look)
						g.Transparency = 0.82 + f * 0.14 -- faint; fades further back
					end
				end
			end
		end
		for plr in pairs(ghosts) do
			if not seen[plr] then
				clearFor(plr)
			end
		end
	end))
end

-- FOV circle: a GUI ring centered on the crosshair (inset-free espGui)
local fovCircle = Instance.new("Frame")
fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
fovCircle.BackgroundTransparency = 1
fovCircle.Visible = false
fovCircle.Parent = espGui
local fovCorner = Instance.new("UICorner")
fovCorner.CornerRadius = UDim.new(1, 0)
fovCorner.Parent = fovCircle
local fovStroke = Instance.new("UIStroke")
fovStroke.Color = Color3.fromRGB(255, 255, 255)
fovStroke.Thickness = 1
fovStroke.Transparency = 0.35
fovStroke.Parent = fovCircle

-- sticky aim: the Player the aimbot has committed to; kept until you stop aiming
local aimStickyPlr = nil
table.insert(uisConnections, RunService.RenderStepped:Connect(function()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	-- FOV circle centered on the crosshair (espGui ignores the GUI inset,
	-- so 0.5,0.5 is the true screen center)
	if (combatState.aimbotEnabled or silentState.enabled) and combatState.showFov then
		local fov = combatState.aimbotEnabled and combatState.aimFov or silentState.fov
		local d = fov * 2
		fovCircle.Size = UDim2.fromOffset(d, d)
		fovCircle.Visible = true
	else
		fovCircle.Visible = false
	end

	if combatState.aimbotEnabled and (combatState.aimAlways or isAimKeyDown()) then
		local head
		-- sticky: while a locked target is still alive, keep aiming at it (re-resolve
		-- its aim part each frame) instead of switching to whoever's now closest
		if combatState.aimSticky and aimStickyPlr then
			local char = aliveTarget(aimStickyPlr)
			head = char and char:FindFirstChild(combatState.aimHead and "Head" or "HumanoidRootPart")
			if not head then
				aimStickyPlr = nil -- died / left → fall through and re-acquire
			end
		end
		if not head then
			head = getAimTarget(camera)
			if combatState.aimSticky and head then
				aimStickyPlr = Players:GetPlayerFromCharacter(head.Parent)
			end
		end
		if head then
			local camPos = camera.CFrame.Position
			local hp = aimPos(head)
			-- prediction: lead the aim by a fraction of the target's velocity
			if combatState.aimPrediction then
				local ok, vel = pcall(function()
					return head.AssemblyLinearVelocity
				end)
				if ok and typeof(vel) == "Vector3" then
					hp = hp + vel * (combatState.aimPredictionAmount / 100)
				end
			end
			-- avoid a CFrame.lookAt NaN when the target is exactly overhead
			local horiz = (Vector2.new(hp.X, hp.Z) - Vector2.new(camPos.X, camPos.Z)).Magnitude
			if horiz > 0.05 then
				local goal = CFrame.lookAt(camPos, hp)
				local s = combatState.aimSmoothness
				if s <= 1 then
					camera.CFrame = goal
				else
					camera.CFrame = camera.CFrame:Lerp(goal, math.clamp(1 / s, 0, 1))
				end
			end
		end
	else
		aimStickyPlr = nil -- not aiming → release the sticky lock
	end
end))

-- ---- off-screen arrows: point toward enemies who are off-screen ----
-- Each arrow sits on a ring whose radius follows the aim FOV circle (so it grows
-- as the circle grows); it's placed in the enemy's screen-space direction (works
-- for targets behind you via a camera-axis projection) and rotated to point out.
do
	local arrows = {} -- [player] = TextLabel
	local function getArrow(plr)
		local a = arrows[plr]
		if not a then
			a = Instance.new("TextLabel")
			a.Size = UDim2.fromOffset(24, 24)
			a.AnchorPoint = Vector2.new(0.5, 0.5)
			a.BackgroundTransparency = 1
			a.Text = utf8.char(0x25B2) -- ▲
			a.TextColor3 = Color3.fromRGB(255, 255, 255)
			a.TextStrokeTransparency = 0.4
			a.TextSize = 20
			a.Font = Enum.Font.GothamBold
			a.ZIndex = 10
			a.Visible = false
			a.Parent = espGui
			arrows[plr] = a
		end
		return a
	end
	table.insert(uisConnections, RunService.RenderStepped:Connect(function()
		local camera = Workspace.CurrentCamera
		if not offscreenArrows or not camera then
			for _, a in pairs(arrows) do
				a.Visible = false
			end
			return
		end
		local vp = camera.ViewportSize
		local center = vp / 2
		local fovOn = (combatState.aimbotEnabled or silentState.enabled) and combatState.showFov
		local baseR = fovOn and ((combatState.aimbotEnabled and combatState.aimFov or silentState.fov) + 28) or 170
		local R = math.min(baseR, math.min(vp.X, vp.Y) / 2 - 24)
		local cf = camera.CFrame
		local seen = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local char = plr.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if char and hum and hrp and hum.Health > 0 then
					local sp = camera:WorldToViewportPoint(hrp.Position)
					local onScreen = sp.Z > 0 and sp.X >= 0 and sp.X <= vp.X and sp.Y >= 0 and sp.Y <= vp.Y
					if not onScreen then
						local to = hrp.Position - cf.Position
						local ang = math.atan2(cf.UpVector:Dot(to), cf.RightVector:Dot(to))
						local a = getArrow(plr)
						a.Position = UDim2.fromOffset(center.X + math.cos(ang) * R, center.Y - math.sin(ang) * R)
						a.Rotation = 90 - math.deg(ang)
						a.Visible = true
						seen[plr] = true
					end
				end
			end
		end
		for plr, a in pairs(arrows) do
			if not seen[plr] then
				a.Visible = false
			end
		end
	end))
end

-- ---- triggerbot: auto-click when the cursor/crosshair is over a player ----
local canClick = typeof(mouse1click) == "function"
local triggerMouse = player:GetMouse()
local triggerCd = false

-- Fire the weapon every way we can, so it works regardless of how the game
-- reads input: a legacy click (mouse1click), activating an equipped Tool, AND a
-- VirtualInputManager click (a real synthetic event that UserInputService picks
-- up — some games only detect shots via UIS.InputBegan, which mouse1click misses).
local VIM = nil
pcall(function()
	VIM = game:GetService("VirtualInputManager")
end)
local function fireWeapon()
	local char = player.Character
	local tool = char and char:FindFirstChildOfClass("Tool")
	-- Fire EVERY way the game might read a shot, on every call. This game ignores
	-- Tool:Activate, and on this executor mouse1click alone didn't register either —
	-- the VirtualInputManager synthetic click (a genuine UserInputService MouseButton1
	-- event) is what actually lands the shot, so it must fire UNCONDITIONALLY. Gating
	-- it behind "no mouse1click" is exactly what silently broke triggerbot. The cost
	-- is a little first-person camera jitter while it's rapidly shooting.
	if canClick then
		pcall(mouse1click)
	end
	if tool then
		pcall(function()
			tool:Activate()
		end)
	end
	if VIM then
		pcall(function()
			local x, y = triggerMouse.X, triggerMouse.Y
			VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
			VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
		end)
	end
end

-- true when the cursor is hovering the menu window (so synthesized clicks from
-- triggerbot / kill aura don't activate menu controls)
local function overMenu()
	if not window.Visible then
		return false
	end
	local mx, my = triggerMouse.X, triggerMouse.Y
	local wp, ws = window.AbsolutePosition, window.AbsoluteSize
	return mx >= wp.X and mx <= wp.X + ws.X and my >= wp.Y and my <= wp.Y + ws.Y
end

-- Fire when the camera->cursor ray actually lands on a player. In first person
-- the cursor is locked to the centre crosshair, so the one ray covers both
-- "cursor over them" (third person) and "in my crosshair" (first person).
local triggerParams = RaycastParams.new()
triggerParams.FilterType = Enum.RaycastFilterType.Exclude

-- shared cache of NPC target parts, refreshed ~1/s while kill aura or the
-- spinbot-triggerbot needs it (scanning every NPC each frame would lag)
