-- ---- Bypass Locked Doors: make the door read as UNLOCKED so you can open it
-- normally. These doors (Workspace.Map.Doors.<Color>Door) show "Locked" from
-- outside. We flip any lock-ish attribute / BoolValue to false and lift the
-- "barrier" part out of the door (kept, re-attached when off), so the door's own
-- script no longer sees a barricade/lock — then the DoorPrompt opens it. ----
do
	local detached = {} -- [barrierPart] = original parent (to restore when off)
	-- From the in-game dump, a door's ProximityPrompt (DoorPrompt) carries the lock
	-- state as attributes: Locked (bool), Barricades (number of barricades), LockStress,
	-- LockDurability (numbers), Cooldown (bool). Force them to the "unlocked / no
	-- barricade" values so the prompt reads "Open" and you can open it with E.
	-- Dump note: a locked door has Durability > 0 (the physical Lock's HP you shoot
	-- down; open doors show Durability = 0) even while the Locked attr is already
	-- false — so Durability = 0 is the real "unlocked" state.
	local UNLOCK = { Locked = false, Barricades = 0, LockStress = 0, LockDurability = 0, Durability = 0, Cooldown = false }
	local function unlock(node)
		local ok, attrs = pcall(function()
			return node:GetAttributes()
		end)
		if not ok or not attrs then
			return
		end
		for k, v in pairs(attrs) do
			local kl = string.lower(k)
			if UNLOCK[k] ~= nil then
				pcall(function()
					node:SetAttribute(k, UNLOCK[k])
				end)
			elseif type(v) == "boolean" and (kl:find("lock") or kl:find("barricad") or kl:find("seal") or kl:find("closed")) then
				pcall(function()
					node:SetAttribute(k, false)
				end)
			elseif type(v) == "number" and (kl:find("barricad") or kl:find("lockstress") or kl:find("lockdurab")) then
				pcall(function()
					node:SetAttribute(k, 0)
				end)
			end
		end
	end
	local acc = 999
	table.insert(uisConnections, RunService.Heartbeat:Connect(function(dt)
		if exploitState.bypassDoors then
			acc = acc + dt
			if acc < 0.2 then
				return
			end
			acc = 0
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local map = Workspace:FindFirstChild("Map")
			local doorsFolder = map and map:FindFirstChild("Doors")
			if not (hrp and doorsFolder) then
				return
			end
			local myPos = hrp.Position
			for _, door in ipairs(doorsFolder:GetChildren()) do
				local ref = door:IsA("Model") and (door:FindFirstChildWhichIsA("BasePart", true) or door.PrimaryPart) or nil
				if ref and (ref.Position - myPos).Magnitude < 26 then
					unlock(door)
					for _, ch in ipairs(door:GetDescendants()) do
						unlock(ch) -- catches the DoorPrompt + any nested lock nodes
						if ch:IsA("BoolValue") and (string.find(ch.Name:lower(), "lock") or string.find(ch.Name:lower(), "barricad")) then
							pcall(function()
								ch.Value = false
							end)
						end
						if ch:IsA("BasePart") and ch.Name:lower():find("barrier") and ch.Parent then
							detached[ch] = ch.Parent
							ch.Parent = nil
						end
					end
				end
			end
		elseif next(detached) then
			for part, par in pairs(detached) do
				pcall(function() part.Parent = par end)
			end
			detached = {}
		end
	end))
end

-- ---- Bypass Mines: float the character a few studs higher (via HipHeight) so
-- ground landmines never touch it and can't trigger. Restored when off. ----
do
	local myChar, origHip, applied = nil, nil, false
	local LIFT = 1.8 -- studs above normal; just enough to clear ground mines
	table.insert(uisConnections, RunService.Heartbeat:Connect(function()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		if char ~= myChar then
			myChar, origHip, applied = char, hum.HipHeight, false
		end
		if exploitState.bypassMines then
			local want = origHip + LIFT
			if math.abs(hum.HipHeight - want) > 0.05 then
				hum.HipHeight = want
			end
			applied = true
		elseif applied then
			hum.HipHeight = origHip
			applied = false
		end
	end))
end

