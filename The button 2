local function setOpen(open)
	if menuOpen == open or closing then
		return
	end
	menuOpen = open
	menuShown = open
	updatePreviewVisibility()
	if open then
		reopenButton.Visible = false
		window.Visible = true
		setBackdrop(true)
		TweenService:Create(windowScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = userScale }):Play()
	else
		-- a drag held through the hide would keep moving the invisible window
		dragging = false
		activeDrag = nil
		setBackdrop(false)
		closeColorPicker()
		local out = TweenService:Create(windowScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.01 })
		out.Completed:Once(function(state)
			if state == Enum.PlaybackState.Completed then
				window.Visible = false
				reopenButton.Visible = true
			end
		end)
		out:Play()
	end
end

