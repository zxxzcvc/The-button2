-- project a world point through the viewport camera to viewport-local pixels
local function projectPreview(worldPos)
	local rel = vpCamera.CFrame:PointToObjectSpace(worldPos)
	if rel.Z >= -0.05 then
		return nil -- behind / at the camera
	end
	local tanHalf = math.tan(math.rad(vpCamera.FieldOfView / 2))
	local aspect = BB_W / BB_H
	local ndcX = (rel.X / -rel.Z) / (tanHalf * aspect)
	local ndcY = (rel.Y / -rel.Z) / tanHalf
	return (ndcX * 0.5 + 0.5) * BB_W, (0.5 - ndcY * 0.5) * BB_H
end

-- (refreshPreview was forward-declared above so tryLoadAvatar can call it)
refreshPreview = function()
	local on = espEnabled
	local model = previewModel

	-- project the dummy's bounding box to a screen rect (stage coords)
	local rx, ry, rw, rh
	if model then
		local cf, size = model:GetBoundingBox()
		local c = cf.Position
		local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
		local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
		local any = false
		for _, m in ipairs({
			Vector3.new(hx, hy, hz), Vector3.new(hx, hy, -hz), Vector3.new(hx, -hy, hz), Vector3.new(hx, -hy, -hz),
			Vector3.new(-hx, hy, hz), Vector3.new(-hx, hy, -hz), Vector3.new(-hx, -hy, hz), Vector3.new(-hx, -hy, -hz),
		}) do
			local sx, sy = projectPreview(c + m)
			if sx then
				any = true
				minX, maxX = math.min(minX, sx), math.max(maxX, sx)
				minY, maxY = math.min(minY, sy), math.max(maxY, sy)
			end
		end
		if any then
			minX, maxX = math.clamp(minX, 0, BB_W), math.clamp(maxX, 0, BB_W)
			minY, maxY = math.clamp(minY, 0, BB_H), math.clamp(maxY, 0, BB_H)
			rx, ry = BB_X + minX, BB_Y + minY
			rw, rh = math.max(2, maxX - minX), math.max(2, maxY - minY)
		end
	end
	rx, ry, rw, rh = rx or BB_X, ry or BB_Y, rw or BB_W, rh or BB_H

	local b = espConfig.Box
	boxOverlay.Position = UDim2.fromOffset(rx - 2, ry - 2)
	boxOverlay.Size = UDim2.fromOffset(rw + 4, rh + 4)
	boxOverlay.Visible = on and b.enabled
	boxStroke.Color = b.color
	boxStroke.Transparency = 1 - b.alpha

	local o = espConfig.Outline
	outlineOverlay.Position = UDim2.fromOffset(rx, ry)
	outlineOverlay.Size = UDim2.fromOffset(rw, rh)
	outlineOverlay.Visible = on and o.enabled
	outlineStroke.Color = o.color
	outlineStroke.Transparency = 1 - o.alpha

	local s = espConfig.Shader
	shaderFill.Position = UDim2.fromOffset(rx, ry)
	shaderFill.Size = UDim2.fromOffset(rw, rh)
	shaderFill.Visible = on and s.enabled
	shaderFill.BackgroundColor3 = s.color
	shaderFill.BackgroundTransparency = 1 - s.alpha

	local he = espConfig.Health
	previewHealthBg.Position = UDim2.fromOffset(rx - 5, ry)
	previewHealthBg.Size = UDim2.fromOffset(3, rh)
	previewHealthBg.Visible = on and he.enabled -- dummy is at full HP → green

	local t = espConfig.Tracer
	if on and t.enabled then
		drawLine(tracerOverlay, PREVIEW_WIDTH / 2, STAGE_H, rx + rw / 2, ry + rh, 2, t.color, 1 - t.alpha)
	else
		tracerOverlay.Visible = false
	end

	local sk = espConfig.Skeleton
	if on and sk.enabled and model then
		local list = model:FindFirstChild("UpperTorso") and SKELETON_R15 or SKELETON_R6
		local li = 0
		for _, pair in ipairs(list) do
			local p1 = model:FindFirstChild(pair[1])
			local p2 = model:FindFirstChild(pair[2])
			if p1 and p2 and li < SKELETON_MAX then
				local ax, ay = projectPreview(p1.Position)
				local bx, by = projectPreview(p2.Position)
				if ax and bx then
					li += 1
					drawLine(previewBones[li], BB_X + ax, BB_Y + ay, BB_X + bx, BB_Y + by, 2, sk.color, 1 - sk.alpha)
				end
			end
		end
		for i = li + 1, SKELETON_MAX do
			previewBones[i].Visible = false
		end
	else
		for _, bn in ipairs(previewBones) do
			bn.Visible = false
		end
	end
end

