local function tryLoadAvatar()
	local src = player.Character
	if not src then
		return
	end
	local ok, clone = pcall(function()
		src.Archivable = true
		for _, d in ipairs(src:GetDescendants()) do
			pcall(function()
				d.Archivable = true
			end)
		end
		return src:Clone()
	end)
	if not ok or not clone then
		return
	end
	-- strip anything runnable; parts stay put (ViewportFrames don't simulate)
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	local cloneHum = clone:FindFirstChildOfClass("Humanoid")
	if cloneHum then
		pcall(function()
			cloneHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end)
	end
	-- pivot so the avatar faces -Z (toward the camera), like the rig
	if clone.PrimaryPart then
		pcall(function()
			clone:PivotTo(CFrame.new(0, 0, 0))
		end)
	end
	if previewModel and previewModel ~= rig then
		previewModel:Destroy()
	else
		rig.Parent = nil -- tuck the fallback rig away
	end
	clone.Parent = worldModel
	previewModel = clone
	frameModel(clone)
	if refreshPreview then
		refreshPreview() -- re-layout the overlays onto the new model
	end
end

