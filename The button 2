	label.TextColor3 = CONTROL_TEXT
	label.TextSize = 14
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row

	local switch = Instance.new("Frame")
	switch.AnchorPoint = Vector2.new(1, 0.5)
	switch.Position = UDim2.new(1, -rightInset, 0.5, 0)
	switch.Size = UDim2.fromOffset(38, 20)
	switch.BackgroundColor3 = CONTROL_BG
	switch.BorderSizePixel = 0
	switch.Parent = row

	local switchCorner = Instance.new("UICorner")
	switchCorner.CornerRadius = UDim.new(1, 0)
	switchCorner.Parent = switch

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(0, 10, 0.5, 0)
	knob.Size = UDim2.fromOffset(14, 14)
	knob.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
	knob.BorderSizePixel = 0
	knob.Parent = switch

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = knob

	local on = default
	local toggleInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	local function render(instant)
		local knobPos = on and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0)
		local bg = on and themeAccent or CONTROL_BG
		if instant then
			knob.Position = knobPos
			switch.BackgroundColor3 = bg
		else
			TweenService:Create(knob, toggleInfo, { Position = knobPos }):Play()
			TweenService:Create(switch, toggleInfo, { BackgroundColor3 = bg }):Play()
		end
	end
	onTheme(function()
		if on then
			switch.BackgroundColor3 = themeAccent
		end
	end)

	row.MouseButton1Click:Connect(function()
		on = not on
		render(false)
		callback(on)
	end)

	-- setter used by config-load to restore this toggle's saved state
	local function setOn(v)
		v = v and true or false
		if v ~= on then
			on = v
			render(false)
			callback(on)
		end
	end
	local myKey = Config.register(labelText, function()
		return on
	end, setOn)

	-- optional keybind button: bind a key to toggle this feature (right-click clears)
	if bindable then
		local kb = Instance.new("TextButton")
		kb.AnchorPoint = Vector2.new(1, 0.5)
		kb.Position = UDim2.new(1, -rightInset - 46, 0.5, 0)
		kb.Size = UDim2.fromOffset(40, 22)
		kb.BackgroundColor3 = CONTROL_BG
		kb.Text = "+"
		kb.TextColor3 = Color3.fromRGB(175, 175, 190)
		kb.TextSize = 13
		kb.Font = Enum.Font.GothamSemibold
		kb.TextTruncate = Enum.TextTruncate.AtEnd
		kb.AutoButtonColor = false
		kb.BorderSizePixel = 0
		kb.Parent = row
		local kbCorner = Instance.new("UICorner")
		kbCorner.CornerRadius = UDim.new(0, 6)
		kbCorner.Parent = kb
		local myBoundKey = nil
		kb.MouseButton1Click:Connect(function()
			kb.Text = "…"
			bindListen = {
				configKey = myKey,
				label = labelText,
				onSet = function(newKey)
					if myBoundKey and myBoundKey ~= newKey then
						Keybinds[myBoundKey] = nil
					end
					myBoundKey = newKey
					kb.Text = newKey and shortKeyName(newKey) or "+"
				end,
			}
		end)
		kb.MouseButton2Click:Connect(function()
			if myBoundKey then
				Keybinds[myBoundKey] = nil
				myBoundKey = nil
				kb.Text = "+"
				refreshBindHud()
			end
		end)
	end

	render(true)
	return row
end

